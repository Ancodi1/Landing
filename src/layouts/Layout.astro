---
interface Props {
	title?: string;
	description?: string;
	author?: string;
	ogImage?: string;
}

const {
	title = 'Portfolio | Marketing, diseño y desarrollo web',
	description = 'Landing personal para mostrar estrategia de marketing, criterio visual y desarrollo web.',
	author = 'Ángel Collazo Díaz',
	ogImage = 'imx/Venditalia-2026_800x800.jpg'
} = Astro.props;

const siteUrl = new URL('https://ancodi1.github.io/Landing/');
const pagePath = Astro.url.pathname === '/' ? '' : Astro.url.pathname.replace(/^\/+/, '');
const canonicalUrl = new URL(pagePath, siteUrl);
const socialImageUrl = new URL(ogImage.replace(/^\/+/, ''), siteUrl);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="author" content={author} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f5efe5" />
		<meta name="color-scheme" content="light" />

		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content="Portfolio de Ángel Collazo Díaz" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:alt" content="Portfolio de Ángel Collazo Díaz" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl} />
		<meta name="twitter:image:alt" content="Portfolio de Ángel Collazo Díaz" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	:root {
		color-scheme: light;
		--bg: #f5efe5;
		--bg-soft: #fcf8f2;
		--surface: rgba(255, 252, 247, 0.9);
		--surface-strong: #fffcf8;
		--surface-dark: #17171a;
		--text: #141316;
		--muted: #48423b;
		--line: rgba(133, 112, 76, 0.2);
		--accent: #a28757;
		--accent-deep: #684f29;
		--accent-soft: #ebe0c8;
		--teal: #24342f;
		--shadow: 0 20px 50px rgba(28, 21, 12, 0.08);
		--radius-xs: 10px;
		--radius-sm: 16px;
		--radius-md: 24px;
		--radius-lg: 30px;
		--radius-xl: 40px;
		--font-display: 'Plus Jakarta Sans', 'Manrope', 'Segoe UI', Arial, sans-serif;
		--font-sans: 'Manrope', 'Segoe UI', Arial, sans-serif;
	}

	html {
		scroll-behavior: smooth;
	}

	html,
	body {
		margin: 0;
		min-height: 100%;
		width: 100%;
	}

	body {
		font-family: var(--font-sans);
		font-weight: 500;
		background:
			radial-gradient(circle at top left, rgba(162, 135, 87, 0.16), transparent 28%),
			radial-gradient(circle at 100% 10%, rgba(20, 19, 22, 0.05), transparent 22%),
			linear-gradient(180deg, #fbf7f1 0%, #f5efe5 45%, #efe7db 100%);
		color: var(--text);
		position: relative;
	}

	* {
		box-sizing: border-box;
	}

	body::before {
		content: '';
		position: fixed;
		inset: 0;
		pointer-events: none;
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.3), transparent 16%, transparent 84%, rgba(20, 19, 22, 0.04)),
			radial-gradient(circle at center, transparent 55%, rgba(20, 19, 22, 0.03) 100%);
	}

	a {
		color: inherit;
	}
 </style>
