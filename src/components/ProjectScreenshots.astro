---
import type { ProjectScreenshot } from '../data/prestashop-security-module';
interface Props { screenshots: ProjectScreenshot[]; }
const { screenshots } = Astro.props;
const basePath = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
---
{screenshots.length ? (
	<div class:list={['screenshot-grid', { 'screenshot-grid-single': screenshots.length === 1 }]}>
		{screenshots.map((shot) => (
			<figure class="capability-card">
				<a class="screenshot-preview" href={`${basePath}${shot.src.replace(/^\/+/, '')}`} target="_blank" rel="noreferrer" aria-label={`Ampliar: ${shot.alt}`}>
					<img src={`${basePath}${shot.src.replace(/^\/+/, '')}`} alt={shot.alt} width={shot.width} height={shot.height} loading="lazy" decoding="async" />
				</a>
				<figcaption>
					{shot.caption}
					<span class="screenshot-mobile-hint">Desliza horizontalmente para recorrer la imagen.</span>
					<a class="project-link" href={`${basePath}${shot.src.replace(/^\/+/, '')}`} target="_blank" rel="noreferrer">Ver imagen a tamaño completo</a>
				</figcaption>
			</figure>
		))}
	</div>
) : (
	<div class="capability-card">
		<p>Las capturas de la interfaz estarán disponibles próximamente, tras las pruebas finales del módulo.</p>
	</div>
)}
<style>
	.screenshot-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
	.screenshot-grid-single { grid-template-columns: minmax(0, 1fr); }
	.screenshot-grid-single figure { padding: 12px; }
	figure { margin: 0; min-width: 0; }
	.screenshot-preview { display: block; max-width: 100%; overflow-x: auto; border-radius: 16px; }
	img { display: block; width: 100%; height: auto; border-radius: 16px; }
	figcaption { margin-top: 14px; color: var(--muted); line-height: 1.7; }
	figcaption .project-link { display: block; margin-top: 8px; }
	.screenshot-mobile-hint { display: none; }
	@media (max-width: 720px) {
		.screenshot-grid { grid-template-columns: minmax(0, 1fr); }
		.screenshot-grid-single img { min-width: 1100px; }
		.screenshot-grid-single .screenshot-mobile-hint { display: block; margin-top: 8px; }
	}
</style>
