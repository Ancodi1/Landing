---
const flyerAssets = [
	{
		src: '/imx/flyer-a.png',
		title: 'Flyer Venditalia 2026',
		description: 'Flyer vertical completo para Venditalia 2026.',
		width: 1181,
		height: 2480
	},
	{
		src: '/imx/flyer-b.png',
		title: 'Flyer Venditalia 2026',
		description: 'Segunda versión del flyer vertical para Venditalia 2026.',
		width: 1181,
		height: 2480
	}
];

const desktopBannerAsset = {
	src: '/imx/MUESTRABANNERS.png?v=2',
	title: 'Muestra de banners promocionales',
	width: 1920,
	height: 1080
};

const mobileCategoryAssets = [
	{
		src: '/imx/banner-novedades-movil.png',
		title: 'Banner móvil de novedades',
		description:
			'Pieza diseñada para captar atención en formato móvil con un mensaje directo y visual atractivo.',
		width: 700,
		height: 200
	},
	{
		src: '/imx/bannermovil445x154.png',
		title: 'Banner móvil Haribo',
		description: 'Banner compacto adaptado al espacio disponible en dispositivos móviles.',
		width: 445,
		height: 154
	}
];

const videoAssets = [
	{
		src: '/imx/compres-prueba7-banner-pk.mp4',
		title: 'CompresPrueba7BannerPK',
		description: 'Nueva pieza de video integrada como primer banner audiovisual.',
		type: 'video/mp4',
		width: 1920,
		height: 1080
	},
	{
		src: '/imx/durex-fondo-solido.mp4',
		title: 'Durex Fondo Solido',
		description: 'Versión de video con fondo sólido integrada como segunda pieza.',
		type: 'video/mp4',
		width: 700,
		height: 700
	}
];
---

<section id="disenos" class="media-section">
	<div class="media-heading">
		<h3>Mis diseños</h3>
		<p>
			Una muestra de banners web y del flyer de Distribución Mayorista para Venditalia 2026.
		</p>
	</div>

	<section class="asset-group">
		<div class="video-copy">
			<h4>Banners animados</h4>
		</div>
		<div class="video-carousel" data-video-carousel>
			<div class="video-carousel-stage">
				{videoAssets.map((asset, index) => (
					<article
						class={`video-slide${index === 0 ? ' is-active' : ''}`}
						data-video-ratio={`${asset.width} / ${asset.height}`}
						aria-hidden={index === 0 ? 'false' : 'true'}
					>
						<div class="video-main-wrap">
							<video
								class="video-main"
								playsinline
								preload="metadata"
								autoplay
								muted
								loop
								disablepictureinpicture
								controlslist="nofullscreen nodownload noplaybackrate noremoteplayback"
							>
								<source src={asset.src} type={asset.type} />
								Tu navegador no puede reproducir este video.
							</video>
						</div>
					</article>
				))}
			</div>

			<div class="video-carousel-controls" aria-label="Controles de banners animados">
				<button class="video-carousel-button" type="button" data-video-carousel-prev aria-label="Banner anterior">
					<span aria-hidden="true">&lt;</span>
				</button>
				<div class="video-carousel-dots">
					{videoAssets.map((asset, index) => (
						<button
							class={`video-carousel-dot${index === 0 ? ' is-active' : ''}`}
							type="button"
							data-video-carousel-dot={index}
							aria-label={`Ver ${asset.title}`}
							aria-current={index === 0 ? 'true' : 'false'}
						/>
					))}
				</div>
				<button class="video-carousel-button" type="button" data-video-carousel-next aria-label="Banner siguiente">
					<span aria-hidden="true">&gt;</span>
				</button>
			</div>
		</div>
	</section>

	<section class="asset-group">
		<div class="video-copy">
			<h4>Banners sólidos</h4>
			<p>Estos banners publicitarios son muestras de trabajos realizados para marcas. Algunas de las marcas más destacadas para las que se realizan trabajos son Durex, Grefusa, Gullón y Eneryeti, entre otras.</p>
		</div>
	</section>

	<section class="asset-group">
		<figure class="desktop-banner-showcase">
			<img
				src={desktopBannerAsset.src}
				alt={desktopBannerAsset.title}
				width={desktopBannerAsset.width}
				height={desktopBannerAsset.height}
				loading="lazy"
				decoding="async"
			/>
		</figure>

		<details class="mobile-banner-gallery">
			<summary>Ver banners</summary>
			<div class="mobile-banner-list">
				{mobileCategoryAssets.map((asset) => (
					<figure class="mobile-banner-card">
						<img
							src={asset.src}
							alt={asset.title}
							width={asset.width}
							height={asset.height}
							loading="lazy"
							decoding="async"
						/>
					</figure>
				))}
			</div>
		</details>
	</section>

	<section class="asset-group">
		<div class="video-copy">
			<h4>Flyer Venditalia 2026</h4>
		</div>
		<div class="flyer-grid">
			{flyerAssets.map((asset) => (
				<figure class="asset-card flyer-card">
					<a href={asset.src} target="_blank" rel="noreferrer">
						<img
							src={asset.src}
							alt={asset.title}
							width={asset.width}
							height={asset.height}
							loading="lazy"
							decoding="async"
						/>
					</a>
				</figure>
			))}
		</div>
	</section>
</section>

<script>
	document.querySelectorAll('[data-video-carousel]').forEach((carousel) => {
		const slides = Array.from(carousel.querySelectorAll('.video-slide'));
		const dots = Array.from(carousel.querySelectorAll('[data-video-carousel-dot]'));
		const previousButton = carousel.querySelector('[data-video-carousel-prev]');
		const nextButton = carousel.querySelector('[data-video-carousel-next]');
		let activeIndex = 0;
		let timer;

		const setActiveSlide = (nextIndex) => {
			activeIndex = (nextIndex + slides.length) % slides.length;
			const activeSlide = slides[activeIndex];
			const stage = carousel.querySelector('.video-carousel-stage');

			if (stage && activeSlide instanceof HTMLElement) {
				stage.style.setProperty('--active-video-ratio', activeSlide.dataset.videoRatio || '16 / 9');
				stage.classList.toggle('is-square', activeSlide.dataset.videoRatio === '700 / 700');
			}

			slides.forEach((slide, index) => {
				const isActive = index === activeIndex;
				slide.classList.toggle('is-active', isActive);
				slide.setAttribute('aria-hidden', String(!isActive));

				slide.querySelectorAll('video').forEach((video) => {
					if (isActive) {
						video.play().catch(() => {});
					} else {
						video.pause();
						video.currentTime = 0;
					}
				});
			});

			dots.forEach((dot, index) => {
				dot.classList.toggle('is-active', index === activeIndex);
				dot.setAttribute('aria-current', index === activeIndex ? 'true' : 'false');
			});
		};

		const startTimer = () => {
			window.clearInterval(timer);
			timer = window.setInterval(() => setActiveSlide(activeIndex + 1), 6000);
		};

		previousButton?.addEventListener('click', () => {
			setActiveSlide(activeIndex - 1);
			startTimer();
		});

		nextButton?.addEventListener('click', () => {
			setActiveSlide(activeIndex + 1);
			startTimer();
		});

		dots.forEach((dot, index) => {
			dot.addEventListener('click', () => {
				setActiveSlide(index);
				startTimer();
			});
		});

		carousel.addEventListener('mouseenter', () => window.clearInterval(timer));
		carousel.addEventListener('mouseleave', startTimer);
		carousel.addEventListener('focusin', () => window.clearInterval(timer));
		carousel.addEventListener('focusout', startTimer);

		setActiveSlide(0);
		startTimer();
	});
</script>

<style>
	.media-section {
		margin-bottom: 72px;
		padding: 24px;
		border-radius: 32px;
		background: linear-gradient(180deg, var(--surface-warm), rgba(255, 255, 255, 0.58));
		box-shadow: var(--shadow-soft);
	}

	.media-heading {
		margin-bottom: 30px;
		padding-bottom: 18px;
	}

	.media-heading h3 {
		margin: 0 0 10px;
		font-family: var(--font-display);
		font-size: clamp(2rem, 3.4vw, 3rem);
		font-weight: 600;
		line-height: 0.98;
		letter-spacing: -0.035em;
		color: var(--text);
	}

	.media-heading p {
		max-width: 74ch;
		font-size: 1rem;
		line-height: 1.8;
		color: var(--muted);
	}

	.asset-group {
		margin-bottom: 32px;
		padding-top: 8px;
	}

	.asset-card {
		background: transparent;
		box-shadow: none;
		border-radius: 0;
		backdrop-filter: none;
		overflow: hidden;
		position: relative;
	}

	.asset-card a {
		display: flex;
		justify-content: center;
		padding: 24px;
		text-decoration: none;
	}

	.asset-card img {
		display: block;
		width: auto;
		height: auto;
		max-width: 100%;
		image-rendering: auto;
	}

	.flyer-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
	}

	.flyer-card a {
		align-items: flex-start;
		background: rgba(255, 252, 247, 0.2);
	}

	.flyer-card img {
		width: min(100%, 360px);
	}

	.desktop-banner-showcase {
		margin: 0;
		overflow: hidden;
		border-radius: 0;
	}

	.desktop-banner-showcase img {
		display: block;
		width: 100%;
		height: auto;
	}

	.mobile-banner-gallery {
		display: none;
	}

	figcaption,
	.video-copy {
		padding: 0 26px 26px;
	}

	figcaption h4,
	.video-copy h4 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.34rem;
		font-weight: 600;
		line-height: 1.05;
		letter-spacing: -0.035em;
		color: var(--text);
	}

	figcaption p,
	.video-copy p,
	.media-section p,
	.media-section a {
		font-size: 1rem;
		line-height: 1.8;
		color: var(--muted);
	}

	figcaption p:last-child,
	.video-copy p {
		margin: 10px 0 0;
	}

	.video-carousel {
		display: grid;
		gap: 16px;
		max-width: 880px;
		margin: 0 auto;
		padding: 0 16px;
	}

	.video-carousel-stage {
		position: relative;
		width: 100%;
		max-width: 880px;
		margin: 0 auto;
		aspect-ratio: var(--active-video-ratio, 16 / 9);
		overflow: hidden;
		border-radius: 18px;
		background: #f4f1ed;
		box-shadow: 0 16px 34px rgba(28, 21, 12, 0.07);
		transition: max-width 0.35s ease, aspect-ratio 0.35s ease;
	}

	.video-carousel-stage.is-square {
		max-width: min(560px, 100%);
	}

	.video-slide {
		position: absolute;
		inset: 0;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.45s ease;
	}

	.video-slide.is-active {
		opacity: 1;
		pointer-events: auto;
	}

	.video-main-wrap {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		padding: 0;
		background: transparent;
	}

	.video-main {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		border-radius: inherit;
	}

	.video-carousel-controls {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 12px;
	}

	.video-carousel-button {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border: 1px solid rgba(162, 135, 87, 0.16);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.72);
		color: var(--text);
		font-size: 0.9rem;
		font-weight: 800;
		line-height: 1;
		cursor: pointer;
		box-shadow: 0 8px 18px rgba(28, 21, 12, 0.05);
		transition: transform 0.2s ease, background-color 0.2s ease;
	}

	.video-carousel-button:hover {
		transform: translateY(-1px);
		background: rgba(255, 255, 255, 0.94);
	}

	.video-carousel-dots {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.video-carousel-dot {
		width: 8px;
		height: 8px;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: rgba(162, 135, 87, 0.28);
		cursor: pointer;
		transition: width 0.2s ease, background-color 0.2s ease;
	}

	.video-carousel-dot.is-active {
		width: 22px;
		background: var(--accent-deep);
	}

	@media (max-width: 980px) {
		.flyer-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.asset-card a,
		figcaption,
		.video-copy {
			padding-left: 16px;
			padding-right: 16px;
		}

		.asset-card a {
			padding-top: 16px;
		}

		.desktop-banner-showcase {
			display: none;
		}

		.mobile-banner-gallery {
			display: block;
		}

		.mobile-banner-gallery summary {
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 14px 20px;
			border: 1px solid rgba(133, 112, 76, 0.2);
			border-radius: 999px;
			background: rgba(255, 255, 255, 0.86);
			color: var(--text);
			font-size: 0.96rem;
			font-weight: 800;
			cursor: pointer;
			list-style: none;
			box-shadow: 0 10px 24px rgba(28, 21, 12, 0.05);
		}

		.mobile-banner-gallery summary::-webkit-details-marker {
			display: none;
		}

		.mobile-banner-gallery summary::after {
			content: '+';
			margin-left: 10px;
			font-size: 1.25rem;
			line-height: 1;
		}

		.mobile-banner-gallery[open] summary::after {
			content: '-';
		}

		.mobile-banner-list {
			display: grid;
			gap: 18px;
			margin-top: 18px;
		}

		.mobile-banner-card {
			margin: 0;
			overflow: hidden;
			border-radius: 16px;
		}

		.mobile-banner-card img {
			display: block;
			width: 100%;
			height: auto;
		}

		.video-carousel {
			padding: 0;
		}

		.video-carousel-stage {
			border-radius: 16px;
		}

		.video-main {
			border-radius: inherit;
		}

	}
</style>
