---
const flyerAssets = [
	{
		src: '/imx/flyer-a.png',
		title: 'Flyer Venditalia 2026',
		description: 'Flyer vertical completo para Venditalia 2026.',
		width: 1181,
		height: 2480
	},
	{
		src: '/imx/flyer-b.png',
		title: 'Flyer Venditalia 2026',
		description: 'Segunda versión del flyer vertical para Venditalia 2026.',
		width: 1181,
		height: 2480
	}
];

const categoryAssets = [
	{
		src: '/imx/categoria-jake.png',
		title: 'Banner para la marca Jake',
		description:
			'Banner diseñado para mostrar nuevos productos, con espacio en el lado izquierdo para mostrar información relevante de la promoción.',
		width: 1110,
		height: 265
	},
	{
		src: '/imx/eneryeti-categoria.png',
		title: 'Banner para la marca Eneryeti',
		description:
			'Banner diseñado para mostrar nuevos productos, con espacio en el lado izquierdo para mostrar información relevante de la promoción.',
		width: 1110,
		height: 265
	},
	{
		src: '/imx/banner-novedades-movil.png',
		title: 'Banner móvil de novedades',
		description:
			'Pieza diseñada para captar atención en formato móvil con un mensaje directo y visual atractivo.',
		width: 1110,
		height: 265
	},
	{
		src: '/imx/banner-toro-loco.png',
		title: 'Banner promocional Toro Loco',
		description: 'Banner de campaña con información clara y estilo llamativo.',
		width: 1110,
		height: 265
	}
];

const videoAssets = [
	{
		src: '/imx/compres-prueba7-banner-pk.mp4',
		title: 'CompresPrueba7BannerPK',
		description: 'Nueva pieza de video integrada como primer banner audiovisual.',
		type: 'video/mp4'
	},
	{
		src: '/imx/durex-fondo-solido.mp4',
		title: 'Durex Fondo Solido',
		description: 'Versión de video con fondo sólido integrada como segunda pieza.',
		type: 'video/mp4'
	}
];
---

<section id="disenos" class="media-section">
	<div class="media-heading">
		<h3>Mis diseños</h3>
		<p>
			Una muestra de banners web y del flyer de Distribución Mayorista para Venditalia 2026.
		</p>
	</div>

	<section class="asset-group">
		<div class="video-copy">
			<h4>Banners animados</h4>
		</div>
		<div class="video-grid">
			{videoAssets.map((asset) => (
				<article class="asset-card video-card">
					<div class="video-frame">
						<video
							playsinline
							preload="metadata"
							autoplay
							muted
							loop
							disablepictureinpicture
							controlslist="nofullscreen nodownload noplaybackrate noremoteplayback"
						>
							<source src={asset.src} type={asset.type} />
							Tu navegador no puede reproducir este video.
						</video>
					</div>
				</article>
			))}
		</div>
	</section>

	<section class="asset-group">
		<div class="video-copy">
			<h4>Banners sólidos</h4>
			<p>Los espacios en blanco están pensados para CTA, información y accesos directos a puntos de interés.</p>
		</div>
	</section>

	<section class="asset-group">
		<div class="banner-carousel" data-banner-carousel>
			<button class="carousel-button carousel-button-prev" type="button" aria-label="Ver banner anterior">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M15.5 5.5 9 12l6.5 6.5" />
				</svg>
			</button>
			<div class="carousel-viewport">
				<div class="category-track">
					{categoryAssets.map((asset) => (
						<figure class="asset-card category-card">
							<a
								class="banner-zoom-trigger"
								href={asset.src}
								target="_blank"
								rel="noreferrer"
								aria-label={`Ampliar ${asset.title}`}
								data-banner-zoom
								data-banner-src={asset.src}
								data-banner-title={asset.title}
							>
								<img
									src={asset.src}
									alt={asset.title}
									width={asset.width}
									height={asset.height}
									loading="lazy"
									decoding="async"
								/>
							</a>
						</figure>
					))}
				</div>
			</div>
			<button class="carousel-button carousel-button-next" type="button" aria-label="Ver banner siguiente">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="m8.5 5.5 6.5 6.5-6.5 6.5" />
				</svg>
			</button>
			<div class="carousel-dots" aria-label="Banners disponibles">
				{categoryAssets.map((asset, index) => (
					<button
						class:list={['carousel-dot', { 'is-active': index === 0 }]}
						type="button"
						aria-label={`Ver ${asset.title}`}
						aria-current={index === 0 ? 'true' : 'false'}
						data-slide-index={index}
					></button>
				))}
			</div>
		</div>
	</section>

	<dialog class="banner-zoom-dialog" data-banner-zoom-dialog aria-label="Vista ampliada del banner">
		<div class="banner-zoom-toolbar">
			<button class="banner-zoom-control" type="button" aria-label="Reducir zoom" data-banner-zoom-out>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M5 12h14" />
				</svg>
			</button>
			<button class="banner-zoom-control" type="button" aria-label="Aumentar zoom" data-banner-zoom-in>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M12 5v14M5 12h14" />
				</svg>
			</button>
			<button class="banner-zoom-control" type="button" aria-label="Cerrar vista ampliada" data-banner-zoom-close>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M6 6l12 12M18 6 6 18" />
				</svg>
			</button>
		</div>
		<div class="banner-zoom-canvas">
			<img class="banner-zoom-image" src="" alt="" data-banner-zoom-image />
		</div>
	</dialog>

	<section class="asset-group">
		<div class="video-copy">
			<h4>Flyer Venditalia 2026</h4>
		</div>
		<div class="flyer-grid">
			{flyerAssets.map((asset) => (
				<figure class="asset-card flyer-card">
					<a href={asset.src} target="_blank" rel="noreferrer">
						<img
							src={asset.src}
							alt={asset.title}
							width={asset.width}
							height={asset.height}
							loading="lazy"
							decoding="async"
						/>
					</a>
				</figure>
			))}
		</div>
	</section>
</section>

<script>
	const carousels = document.querySelectorAll('[data-banner-carousel]');

	carousels.forEach((carousel) => {
		const viewport = carousel.querySelector('.carousel-viewport');
		const slides = Array.from(carousel.querySelectorAll('.category-card'));
		const dots = Array.from(carousel.querySelectorAll('.carousel-dot'));
		const nextButton = carousel.querySelector('.carousel-button-next');
		const prevButton = carousel.querySelector('.carousel-button-prev');
		const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
		let autoplayId;

		if (!(viewport instanceof HTMLElement) || !(nextButton instanceof HTMLButtonElement) || !(prevButton instanceof HTMLButtonElement)) {
			return;
		}

		const getActiveIndex = () => Math.round(viewport.scrollLeft / viewport.clientWidth);

		const scrollToSlide = (index) => {
			const normalizedIndex = (index + slides.length) % slides.length;

			viewport.scrollTo({
				left: normalizedIndex * viewport.clientWidth,
				behavior: motionQuery.matches ? 'auto' : 'smooth'
			});
		};

		const scrollBySlide = (direction) => {
			const nextIndex = getActiveIndex() + direction;

			if (nextIndex >= slides.length) {
				scrollToSlide(0);
				return;
			}

			if (nextIndex < 0) {
				scrollToSlide(slides.length - 1);
				return;
			}

			viewport.scrollBy({
				left: direction * viewport.clientWidth,
				behavior: motionQuery.matches ? 'auto' : 'smooth'
			});
		};

		const updateDots = () => {
			const activeIndex = getActiveIndex();

			dots.forEach((dot, index) => {
				dot.classList.toggle('is-active', index === activeIndex);
				dot.setAttribute('aria-current', index === activeIndex ? 'true' : 'false');
			});
		};

		const stopAutoplay = () => {
			if (autoplayId) {
				window.clearInterval(autoplayId);
			}
		};

		const startAutoplay = () => {
			stopAutoplay();

			if (motionQuery.matches || slides.length < 2) {
				return;
			}

			autoplayId = window.setInterval(() => {
				scrollBySlide(1);
			}, 3600);
		};

		prevButton.addEventListener('click', () => {
			scrollBySlide(-1);
			startAutoplay();
		});

		nextButton.addEventListener('click', () => {
			scrollBySlide(1);
			startAutoplay();
		});

		dots.forEach((dot) => {
			if (!(dot instanceof HTMLButtonElement)) {
				return;
			}

			dot.addEventListener('click', () => {
				scrollToSlide(Number(dot.dataset.slideIndex));
				startAutoplay();
			});
		});

		viewport.addEventListener('scroll', updateDots, { passive: true });
		carousel.addEventListener('mouseenter', stopAutoplay);
		carousel.addEventListener('mouseleave', startAutoplay);
		carousel.addEventListener('focusin', stopAutoplay);
		carousel.addEventListener('focusout', startAutoplay);

		updateDots();
		startAutoplay();
	});

	const zoomDialog = document.querySelector('[data-banner-zoom-dialog]');
	const zoomImage = document.querySelector('[data-banner-zoom-image]');
	const zoomTriggers = document.querySelectorAll('[data-banner-zoom]');
	const zoomInButton = document.querySelector('[data-banner-zoom-in]');
	const zoomOutButton = document.querySelector('[data-banner-zoom-out]');
	const zoomCloseButton = document.querySelector('[data-banner-zoom-close]');
	let bannerZoom = 1.35;

	const setBannerZoom = (nextZoom) => {
		bannerZoom = Math.min(Math.max(nextZoom, 1), 2.4);

		if (zoomDialog instanceof HTMLElement) {
			zoomDialog.style.setProperty('--banner-zoom-width', `${bannerZoom * 100}%`);
		}
	};

	if (zoomDialog instanceof HTMLDialogElement && zoomImage instanceof HTMLImageElement) {
		zoomTriggers.forEach((trigger) => {
			if (!(trigger instanceof HTMLAnchorElement)) {
				return;
			}

			trigger.addEventListener('click', (event) => {
				event.preventDefault();
				zoomImage.src = trigger.dataset.bannerSrc || trigger.href;
				zoomImage.alt = trigger.dataset.bannerTitle || 'Banner ampliado';
				setBannerZoom(window.matchMedia('(max-width: 720px)').matches ? 1.6 : 1.2);
				zoomDialog.showModal();
			});
		});

		if (zoomInButton instanceof HTMLButtonElement) {
			zoomInButton.addEventListener('click', () => setBannerZoom(bannerZoom + 0.25));
		}

		if (zoomOutButton instanceof HTMLButtonElement) {
			zoomOutButton.addEventListener('click', () => setBannerZoom(bannerZoom - 0.25));
		}

		if (zoomCloseButton instanceof HTMLButtonElement) {
			zoomCloseButton.addEventListener('click', () => zoomDialog.close());
		}

		zoomDialog.addEventListener('click', (event) => {
			if (event.target === zoomDialog) {
				zoomDialog.close();
			}
		});
	}
</script>

<style>
	.media-section {
		margin-bottom: 72px;
		padding: 24px;
		border-radius: 32px;
		background: linear-gradient(180deg, var(--surface-warm), rgba(255, 255, 255, 0.58));
		box-shadow: var(--shadow-soft);
	}

	.media-heading {
		margin-bottom: 30px;
		padding-bottom: 18px;
	}

	.media-heading h3 {
		margin: 0 0 10px;
		font-family: var(--font-display);
		font-size: clamp(2rem, 3.4vw, 3rem);
		font-weight: 600;
		line-height: 0.98;
		letter-spacing: -0.035em;
		color: var(--text);
	}

	.media-heading p {
		max-width: 74ch;
		font-size: 1rem;
		line-height: 1.8;
		color: var(--muted);
	}

	.asset-group {
		margin-bottom: 32px;
		padding-top: 8px;
	}

	.asset-card {
		background: transparent;
		box-shadow: none;
		border-radius: 0;
		backdrop-filter: none;
		overflow: hidden;
		position: relative;
	}

	.asset-card a {
		display: flex;
		justify-content: center;
		padding: 24px;
		text-decoration: none;
	}

	.asset-card img {
		display: block;
		width: auto;
		height: auto;
		max-width: 100%;
		image-rendering: auto;
	}

	.flyer-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
	}

	.flyer-card a {
		align-items: flex-start;
		background: rgba(255, 252, 247, 0.2);
	}

	.flyer-card img {
		width: min(100%, 360px);
	}

	.banner-carousel {
		position: relative;
		display: grid;
		grid-template-columns: 48px minmax(0, 1fr) 48px;
		grid-template-areas:
			"prev viewport next"
			"dots dots dots";
		align-items: center;
		gap: 14px;
	}

	.carousel-button-prev {
		grid-area: prev;
	}

	.carousel-button-next {
		grid-area: next;
	}

	.carousel-viewport {
		grid-area: viewport;
		position: relative;
		overflow-x: auto;
		overscroll-behavior-inline: contain;
		scroll-behavior: smooth;
		scroll-snap-type: x mandatory;
		scrollbar-width: thin;
		scrollbar-color: rgba(133, 112, 76, 0.38) transparent;
	}

	.category-track {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: minmax(88%, 100%);
		gap: 18px;
	}

	.category-card a {
		min-height: 180px;
		align-items: center;
		border-radius: 24px;
		overflow: hidden;
		background: rgba(255, 252, 247, 0.2);
	}

	.category-card {
		scroll-snap-align: center;
	}

	.category-card img {
		width: min(100%, 1110px);
		border-radius: 24px;
		clip-path: inset(0 round 24px);
	}

	.banner-zoom-trigger {
		cursor: zoom-in;
	}

	.banner-zoom-dialog {
		--banner-zoom-width: 120%;
		width: min(1120px, calc(100vw - 28px));
		height: min(78vh, 720px);
		padding: 0;
		border: 0;
		border-radius: 24px;
		background: rgba(255, 252, 247, 0.96);
		box-shadow: 0 28px 90px rgba(28, 21, 12, 0.28);
		overflow: hidden;
	}

	.banner-zoom-dialog::backdrop {
		background: rgba(20, 19, 22, 0.58);
		backdrop-filter: blur(8px);
	}

	.banner-zoom-toolbar {
		position: absolute;
		top: 12px;
		right: 12px;
		z-index: 2;
		display: flex;
		gap: 8px;
	}

	.banner-zoom-control {
		display: grid;
		place-items: center;
		width: 42px;
		height: 42px;
		padding: 0;
		border: 1px solid rgba(133, 112, 76, 0.22);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.9);
		color: var(--text);
		cursor: pointer;
		box-shadow: 0 10px 24px rgba(28, 21, 12, 0.1);
	}

	.banner-zoom-control svg {
		width: 20px;
		height: 20px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.banner-zoom-canvas {
		width: 100%;
		height: 100%;
		padding: 76px 24px 24px;
		overflow: auto;
		-webkit-overflow-scrolling: touch;
	}

	.banner-zoom-image {
		display: block;
		width: var(--banner-zoom-width);
		max-width: none;
		height: auto;
		margin: 0 auto;
		border-radius: 18px;
		box-shadow: 0 16px 44px rgba(28, 21, 12, 0.14);
	}

	.carousel-dots {
		grid-area: dots;
		display: flex;
		justify-content: center;
		gap: 9px;
	}

	.carousel-dot {
		width: 9px;
		height: 9px;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: rgba(133, 112, 76, 0.3);
		cursor: pointer;
		transition:
			width 0.22s ease,
			background-color 0.22s ease;
	}

	.carousel-dot.is-active {
		width: 28px;
		background: var(--accent-deep);
	}

	.carousel-button {
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		border: 1px solid rgba(133, 112, 76, 0.2);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.86);
		color: var(--text);
		cursor: pointer;
		box-shadow: 0 10px 24px rgba(28, 21, 12, 0.05);
		transition:
			transform 0.2s ease,
			background-color 0.2s ease,
			border-color 0.2s ease;
	}

	.carousel-button:hover {
		transform: translateY(-1px);
		background: rgba(255, 255, 255, 0.98);
		border-color: rgba(133, 112, 76, 0.34);
	}

	.carousel-button svg {
		width: 22px;
		height: 22px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	figcaption,
	.video-copy {
		padding: 0 26px 26px;
	}

	figcaption h4,
	.video-copy h4 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.34rem;
		font-weight: 600;
		line-height: 1.05;
		letter-spacing: -0.035em;
		color: var(--text);
	}

	figcaption p,
	.video-copy p,
	.media-section p,
	.media-section a {
		font-size: 1rem;
		line-height: 1.8;
		color: var(--muted);
	}

	figcaption p:last-child,
	.video-copy p {
		margin: 10px 0 0;
	}

	.video-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
		align-items: stretch;
	}

	.video-card {
		display: grid;
		grid-template-rows: auto 1fr;
	}

	.video-frame {
		padding: 16px 16px 0;
	}

	.video-frame video {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		height: auto;
		border-radius: 22px;
		background: #151519;
		object-fit: contain;
	}

	@media (max-width: 980px) {
		.flyer-grid,
		.video-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.asset-card a,
		figcaption,
		.video-copy {
			padding-left: 16px;
			padding-right: 16px;
		}

		.asset-card a {
			padding-top: 16px;
		}

		.video-frame {
			padding: 12px 12px 0;
		}

		.banner-carousel {
			grid-template-columns: 40px minmax(0, 1fr) 40px;
			gap: 8px;
		}

		.category-track {
			grid-auto-columns: 100%;
		}

		.carousel-button {
			width: 40px;
			height: 40px;
		}

		.category-card a {
			min-height: 120px;
		}

		.banner-zoom-dialog {
			width: calc(100vw - 18px);
			height: 76vh;
			border-radius: 20px;
		}

		.banner-zoom-toolbar {
			top: 10px;
			right: 10px;
		}

		.banner-zoom-control {
			width: 38px;
			height: 38px;
		}

		.banner-zoom-canvas {
			padding: 66px 14px 18px;
		}
	}
</style>
