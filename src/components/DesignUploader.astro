---
const flyerAssets = [
	{
		src: '/imx/flyer-a.png',
		title: 'Flyer Venditalia 2026',
		description: 'Flyer vertical completo para Venditalia 2026.',
		width: 1181,
		height: 2480
	},
	{
		src: '/imx/flyer-b.png',
		title: 'Flyer Venditalia 2026',
		description: 'Segunda versión del flyer vertical para Venditalia 2026.',
		width: 1181,
		height: 2480
	}
];

const desktopBannerAsset = {
	src: '/imx/MUESTRABANNERS.png',
	title: 'Muestra de banners promocionales',
	width: 1920,
	height: 1080
};

const mobileCategoryAssets = [
	{
		src: '/imx/banner-novedades-movil.png',
		title: 'Banner móvil de novedades',
		description:
			'Pieza diseñada para captar atención en formato móvil con un mensaje directo y visual atractivo.',
		width: 700,
		height: 200
	},
	{
		src: '/imx/bannermovil445x154.png',
		title: 'Banner móvil Haribo',
		description: 'Banner compacto adaptado al espacio disponible en dispositivos móviles.',
		width: 445,
		height: 154
	}
];

const videoAssets = [
	{
		src: '/imx/compres-prueba7-banner-pk.mp4',
		title: 'CompresPrueba7BannerPK',
		description: 'Nueva pieza de video integrada como primer banner audiovisual.',
		type: 'video/mp4'
	},
	{
		src: '/imx/durex-fondo-solido.mp4',
		title: 'Durex Fondo Solido',
		description: 'Versión de video con fondo sólido integrada como segunda pieza.',
		type: 'video/mp4'
	}
];
---

<section id="disenos" class="media-section">
	<div class="media-heading">
		<h3>Mis diseños</h3>
		<p>
			Una muestra de banners web y del flyer de Distribución Mayorista para Venditalia 2026.
		</p>
	</div>

	<section class="asset-group">
		<div class="video-copy">
			<h4>Banners animados</h4>
		</div>
		<div class="video-grid">
			{videoAssets.map((asset) => (
				<article class="asset-card video-card">
					<div class="video-frame">
						<video
							playsinline
							preload="metadata"
							autoplay
							muted
							loop
							disablepictureinpicture
							controlslist="nofullscreen nodownload noplaybackrate noremoteplayback"
						>
							<source src={asset.src} type={asset.type} />
							Tu navegador no puede reproducir este video.
						</video>
					</div>
				</article>
			))}
		</div>
	</section>

	<section class="asset-group">
		<div class="video-copy">
			<h4>Banners sólidos</h4>
			<p>Estos banners publicitarios son muestras de trabajos realizados para marcas. Algunas de las marcas más destacadas para las que se realizan trabajos son Durex, Grefusa, Gullón y Eneryeti, entre otras.</p>
		</div>
	</section>

	<section class="asset-group">
		<figure class="desktop-banner-showcase">
			<img
				src={desktopBannerAsset.src}
				alt={desktopBannerAsset.title}
				width={desktopBannerAsset.width}
				height={desktopBannerAsset.height}
				loading="lazy"
				decoding="async"
			/>
		</figure>

		<details class="mobile-banner-gallery">
			<summary>Ver banners</summary>
			<div class="mobile-banner-list">
				{mobileCategoryAssets.map((asset) => (
					<figure class="mobile-banner-card">
						<img
							src={asset.src}
							alt={asset.title}
							width={asset.width}
							height={asset.height}
							loading="lazy"
							decoding="async"
						/>
					</figure>
				))}
			</div>
		</details>
	</section>

	<section class="asset-group">
		<div class="video-copy">
			<h4>Flyer Venditalia 2026</h4>
		</div>
		<div class="flyer-grid">
			{flyerAssets.map((asset) => (
				<figure class="asset-card flyer-card">
					<a href={asset.src} target="_blank" rel="noreferrer">
						<img
							src={asset.src}
							alt={asset.title}
							width={asset.width}
							height={asset.height}
							loading="lazy"
							decoding="async"
						/>
					</a>
				</figure>
			))}
		</div>
	</section>
</section>

<style>
	.media-section {
		margin-bottom: 72px;
		padding: 24px;
		border-radius: 32px;
		background: linear-gradient(180deg, var(--surface-warm), rgba(255, 255, 255, 0.58));
		box-shadow: var(--shadow-soft);
	}

	.media-heading {
		margin-bottom: 30px;
		padding-bottom: 18px;
	}

	.media-heading h3 {
		margin: 0 0 10px;
		font-family: var(--font-display);
		font-size: clamp(2rem, 3.4vw, 3rem);
		font-weight: 600;
		line-height: 0.98;
		letter-spacing: -0.035em;
		color: var(--text);
	}

	.media-heading p {
		max-width: 74ch;
		font-size: 1rem;
		line-height: 1.8;
		color: var(--muted);
	}

	.asset-group {
		margin-bottom: 32px;
		padding-top: 8px;
	}

	.asset-card {
		background: transparent;
		box-shadow: none;
		border-radius: 0;
		backdrop-filter: none;
		overflow: hidden;
		position: relative;
	}

	.asset-card a {
		display: flex;
		justify-content: center;
		padding: 24px;
		text-decoration: none;
	}

	.asset-card img {
		display: block;
		width: auto;
		height: auto;
		max-width: 100%;
		image-rendering: auto;
	}

	.flyer-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
	}

	.flyer-card a {
		align-items: flex-start;
		background: rgba(255, 252, 247, 0.2);
	}

	.flyer-card img {
		width: min(100%, 360px);
	}

	.desktop-banner-showcase {
		margin: 0;
		overflow: hidden;
		border-radius: 24px;
	}

	.desktop-banner-showcase img {
		display: block;
		width: 100%;
		height: auto;
	}

	.mobile-banner-gallery {
		display: none;
	}

	figcaption,
	.video-copy {
		padding: 0 26px 26px;
	}

	figcaption h4,
	.video-copy h4 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.34rem;
		font-weight: 600;
		line-height: 1.05;
		letter-spacing: -0.035em;
		color: var(--text);
	}

	figcaption p,
	.video-copy p,
	.media-section p,
	.media-section a {
		font-size: 1rem;
		line-height: 1.8;
		color: var(--muted);
	}

	figcaption p:last-child,
	.video-copy p {
		margin: 10px 0 0;
	}

	.video-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
		align-items: stretch;
	}

	.video-card {
		display: grid;
		grid-template-rows: auto 1fr;
	}

	.video-frame {
		padding: 16px 16px 0;
	}

	.video-frame video {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		height: auto;
		border-radius: 22px;
		background: #151519;
		object-fit: contain;
	}

	@media (max-width: 980px) {
		.flyer-grid,
		.video-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.asset-card a,
		figcaption,
		.video-copy {
			padding-left: 16px;
			padding-right: 16px;
		}

		.asset-card a {
			padding-top: 16px;
		}

		.desktop-banner-showcase {
			display: none;
		}

		.mobile-banner-gallery {
			display: block;
		}

		.mobile-banner-gallery summary {
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 14px 20px;
			border: 1px solid rgba(133, 112, 76, 0.2);
			border-radius: 999px;
			background: rgba(255, 255, 255, 0.86);
			color: var(--text);
			font-size: 0.96rem;
			font-weight: 800;
			cursor: pointer;
			list-style: none;
			box-shadow: 0 10px 24px rgba(28, 21, 12, 0.05);
		}

		.mobile-banner-gallery summary::-webkit-details-marker {
			display: none;
		}

		.mobile-banner-gallery summary::after {
			content: '+';
			margin-left: 10px;
			font-size: 1.25rem;
			line-height: 1;
		}

		.mobile-banner-gallery[open] summary::after {
			content: '-';
		}

		.mobile-banner-list {
			display: grid;
			gap: 18px;
			margin-top: 18px;
		}

		.mobile-banner-card {
			margin: 0;
			overflow: hidden;
			border-radius: 16px;
		}

		.mobile-banner-card img {
			display: block;
			width: 100%;
			height: auto;
		}

		.video-frame {
			padding: 12px 12px 0;
		}

	}
</style>
