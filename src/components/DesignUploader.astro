---
const flyerAssets = [
	{
		src: '/imx/flyer-a.png',
		title: 'Cara A',
		description: 'Flyer vertical completo para Venditalia 2026.',
		width: 1181,
		height: 2480
	},
	{
		src: '/imx/flyer-b.png',
		title: 'Cara B',
		description: 'Segunda version del flyer vertical para Venditalia 2026.',
		width: 1181,
		height: 2480
	}
];

const categoryAssets = [
	{
		src: '/imx/categoria-jake.png',
		title: 'Banner para la marca Jake',
		description:
			'Banner disenado para mostrar nuevos productos, con espacio en el lado izquierdo para mostrar informacion relevante de la promocion.',
		width: 1110,
		height: 265
	},
	{
		src: '/imx/eneryeti-categoria.png',
		title: 'Banner para la marca Eneryeti',
		description:
			'Banner disenado para mostrar nuevos productos, con espacio en el lado izquierdo para mostrar informacion relevante de la promocion.',
		width: 1110,
		height: 265
	}
];

const videoAssets = [
	{
		src: '/imx/compres-prueba7-banner-pk.mp4',
		title: 'CompresPrueba7BannerPK',
		description: 'Nueva pieza de video integrada como primer banner audiovisual.',
		type: 'video/mp4'
	},
	{
		src: '/imx/durex-fondo-solido.mp4',
		title: 'Durex Fondo Solido',
		description: 'Version de video con fondo solido integrada como segunda pieza.',
		type: 'video/mp4'
	}
];
---

<section id="disenos" class="media-section">
	<div class="media-heading">
		<h3>Mis diseños</h3>
		<p>
			Aqui se recogen flyers para Venditalia 2026, banners publicitarios para Jake y Eneryeti, y
			piezas de video pensadas para destacar producto de forma natural y visual.
		</p>
	</div>

	<section class="asset-group">
		<div class="video-grid">
			{videoAssets.map((asset) => (
				<article class="asset-card video-card">
					<div class="video-frame">
						<video
							playsinline
							preload="metadata"
							autoplay
							muted
							loop
							disablepictureinpicture
							controlslist="nofullscreen nodownload noplaybackrate noremoteplayback"
						>
							<source src={asset.src} type={asset.type} />
							Tu navegador no puede reproducir este video.
						</video>
					</div>
				</article>
			))}
		</div>
	</section>

	<section class="asset-group">
		<div class="category-stack">
			{categoryAssets.map((asset) => (
				<figure class="asset-card category-card">
					<figcaption>
						<h4>{asset.title}</h4>
					</figcaption>
					<a href={asset.src} target="_blank" rel="noreferrer">
						<img
							src={asset.src}
							alt={asset.title}
							width={asset.width}
							height={asset.height}
							loading="lazy"
							decoding="async"
						/>
					</a>
				</figure>
			))}
		</div>
	</section>

	<section class="asset-group">
		<div class="flyer-grid">
			{flyerAssets.map((asset) => (
				<figure class="asset-card flyer-card">
					<figcaption>
						<h4>{asset.title}</h4>
					</figcaption>
					<a href={asset.src} target="_blank" rel="noreferrer">
						<img
							src={asset.src}
							alt={asset.title}
							width={asset.width}
							height={asset.height}
							loading="lazy"
							decoding="async"
						/>
					</a>
				</figure>
			))}
		</div>
	</section>
</section>

<style>
	.media-section {
		margin-bottom: 72px;
		padding: 24px;
		border-radius: 32px;
		background: linear-gradient(180deg, var(--surface-warm), rgba(255, 255, 255, 0.58));
		box-shadow: var(--shadow-soft);
	}

	.media-heading {
		margin-bottom: 30px;
		padding-bottom: 18px;
	}

	.media-heading h3 {
		margin: 0 0 10px;
		font-family: var(--font-display);
		font-size: clamp(2rem, 3.4vw, 3rem);
		font-weight: 600;
		line-height: 0.98;
		letter-spacing: -0.035em;
		color: var(--text);
	}

	.media-heading p {
		max-width: 74ch;
		font-size: 1rem;
		line-height: 1.8;
		color: var(--muted);
	}

	.asset-group {
		margin-bottom: 32px;
		padding-top: 8px;
	}

	.asset-card {
		background: transparent;
		box-shadow: none;
		border-radius: 0;
		backdrop-filter: none;
		overflow: hidden;
		position: relative;
	}

	.asset-card a {
		display: flex;
		justify-content: center;
		padding: 24px;
		text-decoration: none;
	}

	.asset-card img {
		display: block;
		width: auto;
		height: auto;
		max-width: 100%;
		image-rendering: auto;
	}

	.flyer-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
	}

	.flyer-card a {
		align-items: flex-start;
		background: rgba(255, 252, 247, 0.2);
	}

	.flyer-card img {
		width: min(100%, 500px);
	}

	.category-stack {
		display: grid;
		gap: 24px;
	}

	.category-card a {
		border-radius: 24px;
		overflow: hidden;
		background: rgba(255, 252, 247, 0.2);
	}

	.category-card img {
		width: min(100%, 1110px);
		border-radius: 24px;
		clip-path: inset(0 round 24px);
	}

	figcaption,
	.video-copy {
		padding: 0 26px 26px;
	}

	figcaption h4,
	.video-copy h4 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.34rem;
		font-weight: 600;
		line-height: 1.05;
		letter-spacing: -0.035em;
		color: var(--text);
	}

	figcaption p,
	.video-copy p,
	.media-section p,
	.media-section a {
		font-size: 1rem;
		line-height: 1.8;
		color: var(--muted);
	}

	figcaption p:last-child,
	.video-copy p {
		margin: 10px 0 0;
	}

	.video-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
		align-items: stretch;
	}

	.video-card {
		display: grid;
		grid-template-rows: auto 1fr;
	}

	.video-frame {
		padding: 16px 16px 0;
	}

	.video-frame video {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		height: auto;
		border-radius: 22px;
		background: #151519;
		object-fit: contain;
	}

	@media (max-width: 980px) {
		.flyer-grid,
		.video-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.asset-card a,
		figcaption,
		.video-copy {
			padding-left: 16px;
			padding-right: 16px;
		}

		.asset-card a {
			padding-top: 16px;
		}

		.video-frame {
			padding: 12px 12px 0;
		}
	}
</style>
