---
import DesignUploader from '../components/DesignUploader.astro';
import Layout from '../layouts/Layout.astro';

const capabilityGroups = [
	{
		title: 'Desarrollo web',
		items: ['HTML5', 'CSS', 'JavaScript', 'PHP', 'SQL', 'C#', 'PrestaShop']
	},
	{
		title: 'Marketing digital',
		items: ['SEO', 'SEM', 'Google Ads', 'Google Analytics']
	},
	{
		title: 'Diseño y audiovisual',
		items: ['Adobe Photoshop, After Effects y Premiere', 'Canva', 'Probance']
	}
];

const featuredProjects = [
	{
		title: 'Audiovisual para landing Venditalia 2026',
		type: 'Evento B2B',
		status: 'Publicado',
		summary:
			'Idea, diseño y montaje de todo el contenido audiovisual.',
		url: 'https://www.distribucionmayorista.business/',
		image: ''
	},
	{
		title: 'Alma Matter',
		type: 'Web para gestión total de clases y alumnos',
		status: 'Portfolio',
		summary:
			'Proyecto diseñado para la gestión de clases y alumnos desde una única plataforma.',
		tools: ['PHP', 'SQL', 'HTML', 'CSS', 'JavaScript'],
		url: 'https://github.com/Ancodi1/Academia-Alma-Matter-Ancodi',
		image: '/imx/logo.png'
	},
	{
		title: 'Web Nana Nails',
		type: 'Presentación profesional',
		status: 'Actual',
		summary:
			'Este sitio es un ejemplo de cómo presento mis capacidades: diseño, copy y desarrollo web integrados.',
		tools: ['Astro', 'HTML', 'CSS', 'Experiencia UX'],
		image: ''
	},
	{
		title: 'Web De Ninghures',
		type: 'Próximo caso',
		status: 'Próximamente',
		summary:
			'Espacio reservado para añadir nuevas landings, campañas o proyectos web cuando estén listos.',
		tools: ['Diseño web', 'Marketing', 'Desarrollo'],
		image: ''
	}
];

---

<Layout
	title="Portfolio | Marketing, diseño y desarrollo web"
	description="Landing personal para mostrar conocimientos en marketing, diseño y desarrollo web desde una propuesta clara y visualmente sólida."
>
	<div class="page-shell" id="top">
		<header class="topbar">
			<a class="brand" href="#top" aria-label="Ir al inicio"><img src="/favicon.svg" alt="Logo" /> Ángel Collazo Díaz</a>
			<nav aria-label="Secciones principales">
				<a href="#proyectos">Proyectos</a>
				<a href="#disenos">Diseños</a>
				<a href="#contacto">Contacto</a>
				<a href="https://www.linkedin.com/in/%C3%A1ngel-collazo-d%C3%ADaz-4896742a9/" target="_blank" rel="noreferrer">LinkedIn</a>
			</nav>
		</header>

		<main>
			<section class="hero section">
				<p class="eyebrow">Diseño, desarrollo y marketing digital</p>
				<h1>Diseño y desarrollo web para marcas que quieren posicionarse y vender mejor.</h1>
				<p class="hero-copy">
					Ofrezco mi experiencia para una estrategia clara, identidad visual definida y desarrollo full stack para hacerlo todo posible.
				</p>
				<div class="hero-actions">
					<a class="button-primary" href="#proyectos">Ver proyectos</a>
				</div>
			</section>

			<section class="section capabilities-band">
				<div class="capabilities-intro">
					<p class="section-kicker">Aptitudes</p>
					<h2>Mi especialidad es unir desarrollo, marketing y diseño dentro de una misma web.</h2>
					<p>
						Hago que cada parte del proyecto funcione en conjunto: estructura, tecnología,
						comunicación visual y herramientas de captación.
					</p>
				</div>

				<div class="capabilities-grid">
					{capabilityGroups.map((group) => (
						<article class="capability-card">
							<h3>{group.title}</h3>
							<p class="capability-tools">
								<span>Herramientas:</span> {group.items.join(', ')}
							</p>
						</article>
					))}
				</div>
			</section>

		<section id="proyectos" class="section projects-band">
			<div class="projects-heading">
				<p class="section-kicker">Proyectos</p>
				<h3>Trabajos hechos por mí, con foco en resultados y estética.</h3>
			</div>

			<div class="projects-grid">
				{featuredProjects.map((project, index) => (
					<article class="project-card">
						{project.url ? (
							<a
								class="project-visual project-visual-link"
								href={project.url}
								target="_blank"
								rel="noreferrer"
								aria-label={`Ver proyecto ${project.title}`}
							>
								{project.image ? (
									<img src={project.image} alt={project.title} loading="lazy" decoding="async" />
								) : (
									<span>{String(index + 1).padStart(2, '0')}</span>
								)}
							</a>
						) : (
							<div class="project-visual">
								{project.image ? (
									<img src={project.image} alt={project.title} loading="lazy" decoding="async" />
								) : (
									<span>{String(index + 1).padStart(2, '0')}</span>
								)}
							</div>
						)}
						<div class="project-content">
							<div class="project-meta">
								<p class="project-category">{project.type}</p>
								<p class="project-status">{project.status}</p>
							</div>
							<h4>
								{project.url ? (
									<a href={project.url} target="_blank" rel="noreferrer">{project.title}</a>
								) : (
									project.title
								)}
							</h4>
							<p>{project.summary}</p>
							{project.tools && (
								<div class="project-tools" aria-label="Herramientas usadas">
									{project.tools.map((tool) => <span>{tool}</span>)}
								</div>
							)}
							{project.url && (
								<a class="project-link" href={project.url} target="_blank" rel="noreferrer">
									{project.url.includes('github.com') ? 'Ver repositorio' : 'Ver proyecto'}
								</a>
							)}
						</div>
					</article>
				))}
			</div>
		</section>

		<DesignUploader />

			<section id="contacto" class="section contact-band">
				<div class="contact-copy">
					<p class="section-kicker">Contacto</p>
					<p>
						Disponible para proyectos freelance. Puedes escribirme por email o visitar mi perfil
						de LinkedIn para ver mi trayectoria y conectar directamente.
					</p>
					<div class="contact-card">
						<p class="contact-name">Ángel Collazo Díaz</p>
						<p class="contact-role">Disponible para proyectos freelance</p>
						<a
							class="linkedin-card"
							href="https://www.linkedin.com/in/%C3%A1ngel-collazo-d%C3%ADaz-4896742a9/"
							target="_blank"
							rel="noreferrer"
							aria-label="Perfil de LinkedIn de Ángel Collazo Díaz"
						>
							<div class="linkedin-mark">
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path
										d="M6.94 8.5A1.56 1.56 0 1 1 6.94 5.38A1.56 1.56 0 0 1 6.94 8.5ZM5.58 18.42V9.7H8.3V18.42H5.58ZM10.02 18.42V9.7H12.63V10.89H12.67C13.03 10.2 13.92 9.47 15.24 9.47C17.98 9.47 18.5 11.27 18.5 13.61V18.42H15.79V14.16C15.79 13.14 15.77 11.83 14.38 11.83C12.98 11.83 12.77 12.92 12.77 14.08V18.42H10.02Z"
									/>
								</svg>
							</div>
							<div class="linkedin-copy">
								<p class="linkedin-label">LinkedIn</p>
								<p class="linkedin-name">Ángel Collazo Díaz</p>
							</div>
						</a>
					</div>
				</div>
			</section>
		</main>
	</div>
</Layout>

<style>
	:root {
		--surface-soft: rgba(255, 255, 255, 0.46);
		--surface-warm: rgba(255, 250, 243, 0.82);
		--shadow-soft: 0 18px 40px rgba(28, 21, 12, 0.06);
	}

	.page-shell {
		width: min(1180px, calc(100% - 40px));
		margin: 0 auto;
		padding: 30px 0 84px;
	}

	.topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding: 16px 20px;
		margin-bottom: 48px;
		position: sticky;
		top: 14px;
		z-index: 10;
		background: rgba(255, 252, 247, 0.78);
		backdrop-filter: blur(18px);
		border: 1px solid var(--line);
		border-radius: 999px;
		box-shadow: 0 10px 30px rgba(28, 21, 12, 0.06);
	}

	.brand {
		margin: 0;
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		text-decoration: none;
		color: inherit;
	}

	.brand:hover,
	.brand:focus,
	.brand:visited {
		color: inherit;
	}

	.brand img {
		width: 42px;
		height: 42px;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	nav a {
		font-size: 0.92rem;
		font-weight: 700;
		text-decoration: none;
		color: var(--muted);
		padding: 10px 16px;
		border-radius: 999px;
		transition:
			color 0.24s ease,
			background-color 0.24s ease;
	}

	nav a:hover {
		color: var(--text);
		background: rgba(162, 135, 87, 0.08);
	}

	.section {
		margin-bottom: 72px;
	}

	.eyebrow {
		margin: 0 0 14px;
		display: inline-block;
		padding: 10px 16px;
		border-radius: 999px;
		background: rgba(162, 135, 87, 0.1);
		font-family: var(--font-sans);
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: #4f4941;
	}

	.section-kicker {
		margin: 0 0 16px;
		display: block;
		padding: 0;
		border: none;
		font-family: var(--font-sans);
		font-size: 1.16rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		line-height: 1.25;
		text-transform: none;
		color: var(--text);
	}

	h1,
	h2,
	h3 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 600;
		letter-spacing: -0.035em;
		color: var(--text);
	}

	h1 {
		max-width: 24ch;
		margin: 0 auto;
		font-size: clamp(2.35rem, 4.6vw, 3.8rem);
		line-height: 1.04;
		text-align: center;
		text-wrap: balance;
	}

	h2 {
		font-size: clamp(2.2rem, 4vw, 3.5rem);
		line-height: 0.98;
	}

	h3 {
		font-size: clamp(1.6rem, 2.2vw, 2.15rem);
		line-height: 1.02;
	}

	p,
	li {
		margin: 0;
		font-size: 1rem;
		line-height: 1.82;
		color: var(--muted);
	}

	.hero {
		text-align: center;
		padding: 34px 24px 38px;
		border-radius: 36px;
		background:
			radial-gradient(circle at top, rgba(255, 255, 255, 0.55), transparent 60%),
			var(--surface-soft);
		box-shadow: var(--shadow-soft);
	}

	.hero-copy {
		max-width: 72ch;
		margin: 18px auto 0;
		font-size: 1rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		justify-content: center;
		margin-top: 20px;
	}

	.button-primary,
	.button-secondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 14px 22px;
		border-radius: 999px;
		text-decoration: none;
		font-weight: 700;
		transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
	}

	.button-primary {
		background: linear-gradient(90deg, #6a3cfd 0%, #2d9cdb 100%);
		color: #ffffff;
	}

	.button-secondary {
		background: rgba(255, 255, 255, 0.88);
		color: var(--text);
		border: 1px solid rgba(133, 112, 76, 0.2);
	}

	.button-primary:hover,
	.button-secondary:hover {
		transform: translateY(-1px);
	}

	.projects-band {
		padding: 34px;
		border-radius: 32px;
		background: linear-gradient(180deg, rgba(255, 249, 241, 0.94), rgba(255, 255, 255, 0.65));
		box-shadow: var(--shadow-soft);
	}

	.projects-heading {
		max-width: 52ch;
		margin-bottom: 28px;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 22px;
	}

	.project-card {
		display: grid;
		grid-template-columns: 156px minmax(0, 1fr);
		gap: 20px;
		padding: 18px;
		border-radius: 24px;
		background: rgba(255, 255, 255, 0.9);
		border: 1px solid rgba(162, 135, 87, 0.12);
	}

	.project-visual {
		display: grid;
		place-items: center;
		min-height: 156px;
		border-radius: 18px;
		overflow: hidden;
		background:
			linear-gradient(135deg, rgba(106, 60, 253, 0.12), rgba(45, 156, 219, 0.12)),
			rgba(255, 250, 243, 0.8);
		color: var(--accent-deep);
		text-decoration: none;
		transition: transform 0.22s ease, box-shadow 0.22s ease;
	}

	.project-visual-link {
		cursor: pointer;
	}

	.project-visual-link:hover {
		transform: translateY(-4px) scale(1.04);
		box-shadow: 0 20px 42px rgba(28, 21, 12, 0.16);
	}

	.project-visual img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.project-visual span {
		font-family: var(--font-display);
		font-size: 2.5rem;
		font-weight: 600;
		line-height: 1;
	}

	.project-content {
		display: grid;
		align-content: start;
		gap: 12px;
		min-width: 0;
	}

	.project-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		align-items: center;
		justify-content: space-between;
	}

	.project-card h4 {
		font-size: 1.25rem;
		margin: 0;
	}

	.project-card h4 a {
		color: inherit;
		text-decoration: none;
		border-bottom: 1px solid transparent;
		transition: color 0.2s ease, border-color 0.2s ease;
	}

	.project-card h4 a:hover {
		color: var(--accent-deep);
		border-bottom-color: rgba(123, 99, 57, 0.32);
	}

	.project-category {
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--accent-deep);
		margin: 0;
	}

	.project-status {
		padding: 6px 10px;
		border-radius: 999px;
		background: rgba(162, 135, 87, 0.1);
		font-size: 0.78rem;
		font-weight: 800;
		line-height: 1.2;
		color: var(--text);
	}

	.project-tools {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		color: var(--text);
	}

	.project-tools span {
		padding: 6px 10px;
		border-radius: 999px;
		background: rgba(255, 250, 243, 0.9);
		border: 1px solid rgba(162, 135, 87, 0.12);
		font-size: 0.82rem;
		font-weight: 700;
		line-height: 1.2;
	}

	.project-link {
		width: fit-content;
		margin-top: 2px;
		font-size: 0.92rem;
		font-weight: 800;
		color: var(--accent-deep);
		text-decoration: none;
		border-bottom: 1px solid rgba(123, 99, 57, 0.32);
		padding-bottom: 3px;
	}

	.project-link:hover {
		color: var(--text);
		border-bottom-color: rgba(20, 19, 22, 0.34);
	}

	@media (max-width: 980px) {
		.projects-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.project-card {
			grid-template-columns: 1fr;
		}

		.project-visual {
			min-height: 132px;
		}
	}

	.capabilities-band,
	.contact-band {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 36px;
		padding: 34px;
		align-items: start;
		border-radius: 32px;
		background: linear-gradient(180deg, var(--surface-warm), rgba(255, 255, 255, 0.58));
		box-shadow: var(--shadow-soft);
	}

	.capabilities-band {
		grid-template-columns: minmax(0, 1fr);
		gap: 28px;
	}

	.capabilities-intro {
		max-width: 68ch;
	}

	.capabilities-intro h2 {
		margin-bottom: 14px;
	}

	.capabilities-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 22px;
	}

	.capability-card {
		display: flex;
		flex-direction: column;
		padding: 24px;
		border-radius: 24px;
		background: rgba(255, 255, 255, 0.62);
		border: 1px solid rgba(162, 135, 87, 0.12);
		box-shadow: 0 10px 24px rgba(28, 21, 12, 0.04);
	}

	.capability-card h3 {
		font-size: 1.34rem;
		margin-bottom: 10px;
	}

	.capability-card p {
		margin-bottom: 14px;
		line-height: 1.7;
	}

	.capability-tools {
		margin-bottom: 0;
		font-size: 0.95rem;
		line-height: 1.65;
		color: var(--text);
	}

	.capability-tools span {
		font-weight: 800;
		color: var(--accent-deep);
	}

	.contact-band {
		grid-template-columns: minmax(0, 1fr);
		max-width: 720px;
	}

	.contact-copy {
		display: grid;
		gap: 18px;
	}

	.contact-card {
		display: grid;
		gap: 12px;
		padding: 28px;
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.48), rgba(162, 135, 87, 0.08)),
			rgba(255, 252, 247, 0.72);
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		overflow: hidden;
	}

	.contact-name {
		font-family: var(--font-display);
		font-size: 2.25rem;
		line-height: 0.96;
		letter-spacing: -0.03em;
		color: var(--text);
	}

	.contact-role {
		font-size: 0.92rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.contact-email {
		width: fit-content;
		font-size: 1rem;
		font-weight: 700;
		color: var(--text);
		text-decoration: none;
		border-bottom: 1px solid rgba(20, 19, 22, 0.2);
		padding-bottom: 3px;
	}

	.contact-email:hover {
		color: var(--accent-deep);
		border-bottom-color: rgba(123, 99, 57, 0.4);
	}

	.linkedin-card {
		display: grid;
		grid-template-columns: 48px minmax(0, 1fr);
		align-items: center;
		gap: 14px;
		margin-top: 10px;
		padding: 14px 16px;
		width: min(100%, 340px);
		border-radius: 18px;
		border: 1px solid var(--line);
		background: rgba(255, 255, 255, 0.58);
		color: var(--text);
		text-decoration: none;
		transition:
			transform 0.28s ease,
			background-color 0.28s ease,
			border-color 0.28s ease,
			box-shadow 0.28s ease;
	}

	.linkedin-mark {
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		border-radius: 14px;
		background: #0a66c2;
		color: #ffffff;
		box-shadow: 0 10px 18px rgba(10, 102, 194, 0.14);
	}

	.linkedin-mark svg {
		width: 21px;
		height: 21px;
		fill: currentColor;
	}

	.linkedin-copy {
		display: grid;
		gap: 2px;
	}

	.linkedin-label {
		font-size: 0.74rem;
		font-weight: 800;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--accent-deep);
	}

	.linkedin-name {
		font-size: 1rem;
		font-weight: 700;
		line-height: 1.3;
		color: var(--text);
	}

	.linkedin-card:hover {
		transform: translateY(-2px);
		background: rgba(255, 255, 255, 0.78);
		box-shadow: 0 14px 32px rgba(28, 21, 12, 0.08);
	}

	.capabilities-band h2,
	.contact-band h2 {
		max-width: 14ch;
	}

	.hero,
	.capabilities-band,
	.contact-band {
		animation: rise 0.8s ease both;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(24px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 980px) {
		.capabilities-band,
		.capabilities-grid,
		.contact-band {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.page-shell {
			width: min(100% - 20px, 1180px);
			padding-top: 12px;
		}

		.topbar {
			flex-direction: column;
			align-items: flex-start;
			padding: 18px;
			border-radius: 22px;
		}

		.hero,
		.capabilities-band,
		.contact-band {
			padding-left: 22px;
			padding-right: 22px;
		}

		h1 {
			max-width: 100%;
			font-size: clamp(2.8rem, 11vw, 3.8rem);
			line-height: 1.04;
		}

