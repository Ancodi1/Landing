---
import DesignUploader from '../components/DesignUploader.astro';
import Layout from '../layouts/Layout.astro';
import logoOmeya from '../imx/logoomeya.png';

const capabilityGroups = [
	{
		title: 'Desarrollo y tecnologías',
		items: ['PHP', 'Java', 'JavaScript', 'C#', 'HTML5', 'CSS3', 'Node.js', 'Spring Boot']
	},
	{
		title: 'Bases de datos y herramientas',
		items: ['MySQL', 'MariaDB', 'SQL', 'Git', 'Docker', 'XAMPP', 'PrestaShop']
	},
	{
		title: 'Marketing digital',
		items: ['SEO', 'SEM', 'Google Ads', 'GA4', 'Analítica web', 'Gestión de contenidos']
	},
	{
		title: 'Diseño y comunicación',
		items: ['Branding', 'Diseño publicitario', 'Canva', 'Photoshop', 'After Effects', 'Premiere', 'Probance']
	},
	{
		title: 'Certificaciones',
		items: [
			'Certificación de Google Analytics',
			'Google Ads Measurement Certification',
			'Hacking web y ethical hacking'
		]
	},
	{
		title: 'Idiomas',
		items: [
			'Inglés · B2',
			'Portugués · B1',
			'Castellano · Nativo',
			'Gallego · Nativo'
		]
	}
];

const featuredProjects = [
	{
		title: 'Audiovisual para landing Venditalia 2026',
		type: 'Evento B2B',
		status: 'Proyecto real',
		highlight: 'Proyectado ante miles de asistentes',
		summary:
			'Idea, diseño y montaje de todo el contenido audiovisual.',
		result:
			'El audiovisual se diseñó como una pieza central del stand para captar la atención en un entorno de gran afluencia y comunicar de forma inmediata la capacidad operativa de la empresa y el alcance de sus servicios. Se proyectó en bucle durante varias horas en pantallas de gran formato, consiguiendo visibilidad ante miles de asistentes.',
		tools: ['Premiere', 'After Effects', 'Edición de vídeo', 'Diseño audiovisual'],
		video: '/imx/Video_Italia_Final_web.mp4',
		image: '/imx/Venditalia-2026_800x800.jpg'
	},
	{
		title: 'Alma Matter',
		type: 'Web para gestión total de clases y alumnos',
		status: 'Proyecto personal',
		highlight: 'Aplicación académica full stack completamente funcional',
		summary:
			'Proyecto personal full stack para gestionar alumnos, asignaturas y exámenes en entidades que imparten cursos o clases online.',
		result:
			'Aplicación funcional y responsive con CRUD, búsqueda, paginación, validaciones y seguridad web. Complejidad media-alta.',
		tools: ['PHP', 'MySQL', 'JavaScript', 'CSS', 'Arquitectura MVC'],
		url: 'https://github.com/Ancodi1/Academia-Alma-Matter-Ancodi',
		image: '/imx/logo.png'
	},
	{
		title: 'Nana Nails',
		type: 'Web para negocio local',
		status: '',
		highlight: 'Presencia digital orientada a captar nuevos clientes',
		summary:
			'Diseño y desarrollo web para Nana Nails, creado para representar la identidad del negocio, presentar sus servicios de forma atractiva y mejorar su visibilidad en las búsquedas locales.',
		result:
			'Una web profesional, responsive y optimizada para facilitar que potenciales clientes encuentren el negocio, conozcan sus servicios y contacten con mayor facilidad.',
		tools: ['Astro', 'Diseño web', 'SEO local', 'Experiencia de usuario', 'Diseño responsive'],
		image: ''
	},
	{
		title: 'Guardia Omeya',
		type: 'Web para clan de gaming',
		status: '',
		summary:
			'Proyecto web para Guardia Omeya, un clan de Mount & Blade II: Bannerlord, pensado como espacio de presentación, comunidad e identidad del grupo.',
		tools: ['Diseño web', 'Desarrollo', 'Experiencia UX'],
		image: logoOmeya.src
	},
	{
		title: 'Coronas Ibéricas',
		type: 'Colaboración en proyecto web',
		status: 'En funcionamiento',
		highlight: 'Colaborador del proyecto',
		summary:
			'Colaboración en el proyecto web de Coronas Ibéricas, actualmente publicado y en funcionamiento.',
		tools: ['Colaboración web', 'Desarrollo web'],
		url: 'https://www.coronasibericas.com/',
		image: ''
	}
];

---

<Layout
	title="Desarrollador Full Stack Freelance en Galicia | Ángel Collazo"
	description="Desarrollador full stack freelance en Galicia. Diseño web, PHP, JavaScript, SEO, Google Ads y marketing digital para empresas de toda España."
>
	<div class="page-shell" id="top">
		<header class="topbar">
			<a class="brand" href="#top" aria-label="Ir al inicio"><img src="/favicon.svg" alt="Logo" /> Ángel Collazo Díaz</a>
			<nav aria-label="Secciones principales">
				<a href="#proyectos">Proyectos</a>
				<a href="#disenos">Diseños</a>
				<a href="#contacto">Contacto</a>
			</nav>
		</header>

		<main>
			<section class="hero section">
				<p class="eyebrow">Desarrollador full stack freelance en Galicia</p>
				<h1>Desarrollo web y marketing digital para empresas que quieren posicionarse y vender mejor.</h1>
				<p class="hero-copy">
					Ayudo a marcas y empresas de Galicia y del resto de España con desarrollo full stack,
					diseño web, SEO, campañas digitales y una estrategia clara para captar clientes.
				</p>
				<div class="hero-actions">
					<a class="button-primary" href="#proyectos">Ver proyectos</a>
					<a class="button-secondary" href="#contacto">Contactar conmigo</a>
					<a
						class="button-secondary"
						href="/Angel-Collazo-Diaz-CV.pdf"
						download="CV-Angel-Collazo-Diaz.pdf"
					>
						Descargar CV
					</a>
				</div>
			</section>

			<section class="section capabilities-band">
				<div class="capabilities-intro">
					<p class="section-kicker">Conocimientos y habilidades</p>
					<h2>Un profesional freelance para desarrollar, comunicar y hacer crecer proyectos digitales.</h2>
					<p>
						Combino programación, marketing digital y diseño para ofrecer un servicio completo,
						desde la parte técnica hasta el posicionamiento y la captación de clientes.
					</p>
				</div>

				<div class="capabilities-grid">
					{capabilityGroups.map((group) => (
						<article class="capability-card">
							<h3>{group.title}</h3>
							<ul class="capability-list">
								{group.items.map((item) => <li>{item}</li>)}
							</ul>
						</article>
					))}
				</div>
			</section>

		<section id="proyectos" class="section projects-band">
			<div class="projects-heading">
				<p class="section-kicker">Proyectos</p>
				<h2>Proyectos de desarrollo web, diseño y marketing digital.</h2>
			</div>

			<div class="projects-grid">
				{featuredProjects.map((project, index) => (
					<article class="project-card">
						{project.video ? (
							<>
								<button
									class="project-visual project-video-trigger"
									type="button"
									data-video-open={`project-video-${index}`}
									aria-label={`Reproducir vídeo de ${project.title}`}
								>
									<img src={project.image} alt="" loading="lazy" decoding="async" />
									<span class="project-play" aria-hidden="true">
										<svg viewBox="0 0 24 24">
											<path d="M8.5 6.2v11.6L18 12 8.5 6.2Z" />
										</svg>
									</span>
								</button>
								<dialog class="project-video-dialog" id={`project-video-${index}`}>
									<button class="project-video-close" type="button" aria-label="Cerrar vídeo">×</button>
									<video controls playsinline preload="metadata" poster={project.image}>
										<source src={project.video} type="video/mp4" />
										Tu navegador no puede reproducir este vídeo.
									</video>
								</dialog>
							</>
						) : project.url ? (
							<a
								class="project-visual project-visual-link"
								href={project.url}
								target="_blank"
								rel="noreferrer"
								aria-label={`Ver proyecto ${project.title}`}
							>
								{project.image ? (
									<img src={project.image} alt={project.title} loading="lazy" decoding="async" />
								) : (
									<span>{String(index + 1).padStart(2, '0')}</span>
								)}
							</a>
						) : (
							<div class="project-visual">
								{project.image ? (
									<img src={project.image} alt={project.title} loading="lazy" decoding="async" />
								) : (
									<span>{String(index + 1).padStart(2, '0')}</span>
								)}
							</div>
						)}
						<div class="project-content">
							<div class="project-meta">
								<p class="project-category">{project.type}</p>
								{project.status && <p class="project-status">{project.status}</p>}
							</div>
							<h4>
								{project.url ? (
									<a href={project.url} target="_blank" rel="noreferrer">{project.title}</a>
								) : (
									project.title
								)}
							</h4>
							{project.highlight && <p class="project-highlight">{project.highlight}</p>}
							<p>{project.summary}</p>
							{project.result && <p class="project-result">{project.result}</p>}
							{project.tools && (
								<div class="project-tools" aria-label="Herramientas usadas">
									{project.tools.map((tool) => <span>{tool}</span>)}
								</div>
							)}
							{project.video && (
								<button
									class="project-link project-video-link"
									type="button"
									data-video-open={`project-video-${index}`}
								>
									Reproducir vídeo
								</button>
							)}
							{project.url && (
								<a class="project-link" href={project.url} target="_blank" rel="noreferrer">
									{project.url.includes('github.com') ? 'Ver repositorio' : 'Ver proyecto'}
								</a>
							)}
						</div>
					</article>
				))}
			</div>
		</section>

		<DesignUploader />

			<section id="contacto" class="section contact-band">
				<div class="contact-copy">
					<p class="section-kicker">Contacto</p>
					<p>
						Disponible como desarrollador web y profesional de marketing digital freelance para
						proyectos en Galicia y toda España. Puedes escribirme por email o visitar mi perfil
						de LinkedIn para conocer mi trayectoria.
					</p>
					<div class="contact-card">
						<p class="contact-name">Ángel Collazo Díaz</p>
						<p class="contact-role">Disponible para proyectos freelance</p>
						<p class="contact-email-context">
							Para propuestas de trabajo, colaboraciones o cualquier consulta, puedes escribirme
							directamente a:
						</p>
						<a class="contact-email" href="mailto:angel.97.cd@gmail.com">
							angel.97.cd@gmail.com
						</a>
						<a
							class="contact-cv"
							href="/Angel-Collazo-Diaz-CV.pdf"
							download="CV-Angel-Collazo-Diaz.pdf"
						>
							Descargar currículum
						</a>
						<a
							class="linkedin-card"
							href="https://www.linkedin.com/in/%C3%A1ngel-collazo-d%C3%ADaz-4896742a9/"
							target="_blank"
							rel="noreferrer"
							aria-label="Perfil de LinkedIn de Ángel Collazo Díaz"
						>
							<div class="linkedin-mark">
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path
										d="M6.94 8.5A1.56 1.56 0 1 1 6.94 5.38A1.56 1.56 0 0 1 6.94 8.5ZM5.58 18.42V9.7H8.3V18.42H5.58ZM10.02 18.42V9.7H12.63V10.89H12.67C13.03 10.2 13.92 9.47 15.24 9.47C17.98 9.47 18.5 11.27 18.5 13.61V18.42H15.79V14.16C15.79 13.14 15.77 11.83 14.38 11.83C12.98 11.83 12.77 12.92 12.77 14.08V18.42H10.02Z"
									/>
								</svg>
							</div>
							<div class="linkedin-copy">
								<p class="linkedin-label">LinkedIn</p>
								<p class="linkedin-name">Ángel Collazo Díaz</p>
							</div>
						</a>
					</div>
				</div>
			</section>
		</main>
	</div>
</Layout>

<script>
	document.querySelectorAll('[data-video-open]').forEach((trigger) => {
		trigger.addEventListener('click', () => {
			const dialogId = trigger.getAttribute('data-video-open');
			const dialog = dialogId ? document.getElementById(dialogId) : null;

			if (dialog instanceof HTMLDialogElement) {
				dialog.showModal();
				dialog.querySelector('video')?.play().catch(() => {});
			}
		});
	});

	document.querySelectorAll('.project-video-dialog').forEach((dialog) => {
		if (!(dialog instanceof HTMLDialogElement)) return;

		const video = dialog.querySelector('video');
		const closeButton = dialog.querySelector('.project-video-close');
		const closeVideo = () => dialog.close();

		closeButton?.addEventListener('click', closeVideo);
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) closeVideo();
		});
		dialog.addEventListener('close', () => {
			if (video) {
				video.pause();
				video.currentTime = 0;
			}
		});
	});
</script>

<style>
	:root {
		--surface-soft: rgba(255, 255, 255, 0.46);
		--surface-warm: rgba(255, 250, 243, 0.82);
		--shadow-soft: 0 18px 40px rgba(28, 21, 12, 0.06);
	}

	.page-shell {
		width: min(1180px, calc(100% - 40px));
		margin: 0 auto;
		padding: 30px 0 84px;
	}

	.topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding: 16px 20px;
		margin-bottom: 48px;
		position: sticky;
		top: 14px;
		z-index: 10;
		background: rgba(255, 252, 247, 0.78);
		backdrop-filter: blur(18px);
		border: 1px solid var(--line);
		border-radius: 999px;
		box-shadow: 0 10px 30px rgba(28, 21, 12, 0.06);
	}

	.brand {
		margin: 0;
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		text-decoration: none;
		color: inherit;
	}

	.brand:hover,
	.brand:focus,
	.brand:visited {
		color: inherit;
	}

	.brand img {
		width: 42px;
		height: 42px;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	nav a {
		font-size: 0.92rem;
		font-weight: 700;
		text-decoration: none;
		color: var(--muted);
		padding: 10px 16px;
		border-radius: 999px;
		transition:
			color 0.24s ease,
			background-color 0.24s ease;
	}

	nav a:hover {
		color: var(--text);
		background: rgba(162, 135, 87, 0.08);
	}

	.section {
		margin-bottom: 72px;
	}

	.eyebrow {
		margin: 0 0 22px;
		display: inline-block;
		padding: 12px 22px;
		border-radius: 999px;
		background: linear-gradient(100deg, #1f302b 0%, #466258 100%);
		border: 1px solid rgba(255, 255, 255, 0.24);
		box-shadow: 0 10px 26px rgba(31, 48, 43, 0.24);
		font-family: var(--font-sans);
		font-size: clamp(0.84rem, 1.5vw, 0.96rem);
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #ffffff;
	}

	.section-kicker {
		margin: 0 0 16px;
		display: block;
		padding: 0;
		border: none;
		font-family: var(--font-sans);
		font-size: 1.16rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		line-height: 1.25;
		text-transform: none;
		color: var(--text);
	}

	h1,
	h2,
	h3 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 600;
		letter-spacing: -0.035em;
		color: var(--text);
	}

	h1 {
		max-width: 24ch;
		margin: 0 auto;
		font-size: clamp(2.35rem, 4.6vw, 3.8rem);
		line-height: 1.04;
		text-align: center;
		text-wrap: balance;
	}

	h2 {
		font-size: clamp(2.2rem, 4vw, 3.5rem);
		line-height: 0.98;
	}

	h3 {
		font-size: clamp(1.6rem, 2.2vw, 2.15rem);
		line-height: 1.02;
	}

	p,
	li {
		margin: 0;
		font-size: 1rem;
		line-height: 1.82;
		color: var(--muted);
	}

	.hero {
		text-align: center;
		padding: 34px 24px 38px;
		border-radius: 36px;
		background:
			radial-gradient(circle at top, rgba(255, 255, 255, 0.55), transparent 60%),
			var(--surface-soft);
		box-shadow: var(--shadow-soft);
	}

	.hero-copy {
		max-width: 72ch;
		margin: 18px auto 0;
		font-size: 1rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		justify-content: center;
		margin-top: 20px;
	}

	.button-primary,
	.button-secondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 14px 22px;
		border-radius: 999px;
		text-decoration: none;
		font-weight: 700;
		transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
	}

	.button-primary {
		background: linear-gradient(90deg, #1f302b 0%, #466258 100%);
		color: #ffffff;
		box-shadow: 0 10px 22px rgba(31, 48, 43, 0.2);
	}

	.button-secondary {
		background: rgba(255, 255, 255, 0.88);
		color: var(--text);
		border: 1px solid rgba(133, 112, 76, 0.2);
	}

	.button-primary:hover,
	.button-secondary:hover {
		transform: translateY(-1px);
	}

	.projects-band {
		padding: 34px;
		border-radius: 32px;
		background: linear-gradient(180deg, rgba(255, 249, 241, 0.94), rgba(255, 255, 255, 0.65));
		box-shadow: var(--shadow-soft);
	}

	.projects-heading {
		max-width: none;
		margin-bottom: 28px;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 22px;
	}

	.project-card {
		display: grid;
		grid-template-columns: 156px minmax(0, 1fr);
		align-items: start;
		gap: 20px;
		padding: 18px;
		border-radius: 24px;
		background: rgba(255, 255, 255, 0.9);
		border: 1px solid rgba(162, 135, 87, 0.12);
	}

	.project-visual {
		display: grid;
		place-items: center;
		min-height: 156px;
		aspect-ratio: 1;
		border-radius: 18px;
		overflow: hidden;
		background:
			linear-gradient(135deg, rgba(123, 99, 57, 0.16), rgba(162, 135, 87, 0.1)),
			rgba(255, 250, 243, 0.8);
		color: var(--accent-deep);
		text-decoration: none;
		transition: transform 0.22s ease, box-shadow 0.22s ease;
	}

	.project-visual-link {
		cursor: pointer;
	}

	.project-visual-link:hover {
		transform: translateY(-4px) scale(1.04);
		box-shadow: 0 20px 42px rgba(28, 21, 12, 0.16);
	}

	.project-visual img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.project-video-trigger {
		position: relative;
		width: 100%;
		padding: 0;
		border: 0;
		cursor: pointer;
	}

	.project-play {
		position: absolute;
		inset: 50% auto auto 50%;
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		padding: 0;
		border-radius: 50%;
		transform: translate(-50%, -50%);
		background: rgba(31, 48, 43, 0.92);
		box-shadow: 0 10px 28px rgba(20, 19, 22, 0.3);
		color: #fff;
	}

	.project-play svg {
		display: block;
		width: 23px;
		height: 23px;
		fill: currentColor;
	}

	.project-video-dialog {
		width: min(94vw, 1200px);
		max-width: none;
		padding: 0;
		border: 0;
		border-radius: 20px;
		overflow: visible;
		background: #111;
		box-shadow: 0 30px 90px rgba(0, 0, 0, 0.5);
	}

	.project-video-dialog::backdrop {
		background: rgba(15, 14, 13, 0.86);
		backdrop-filter: blur(8px);
	}

	.project-video-dialog video {
		display: block;
		width: 100%;
		max-height: 88vh;
		border-radius: 20px;
		object-fit: contain;
	}

	.project-video-close {
		position: absolute;
		top: -18px;
		right: -18px;
		z-index: 1;
		display: grid;
		place-items: center;
		width: 42px;
		height: 42px;
		padding: 0;
		border: 2px solid rgba(255, 255, 255, 0.7);
		border-radius: 50%;
		background: #1f302b;
		font-size: 1.7rem;
		line-height: 1;
		color: #fff;
		cursor: pointer;
	}

	.project-visual span {
		font-family: var(--font-display);
		font-size: 2.5rem;
		font-weight: 600;
		line-height: 1;
	}

	.project-content {
		display: grid;
		align-content: start;
		gap: 12px;
		min-width: 0;
	}

	.project-result {
		padding-left: 12px;
		border-left: 2px solid rgba(104, 79, 41, 0.35);
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.project-highlight {
		width: fit-content;
		padding: 7px 12px;
		border-radius: 999px;
		background: rgba(31, 48, 43, 0.1);
		font-size: 0.84rem;
		font-weight: 800;
		line-height: 1.3;
		color: #1f302b;
	}

	.project-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		align-items: center;
		justify-content: space-between;
	}

	.project-card h4 {
		font-size: 1.25rem;
