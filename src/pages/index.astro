---
import DesignUploader from '../components/DesignUploader.astro';
import Layout from '../layouts/Layout.astro';
import '../styles/portfolio.css';
import { securityModule } from '../data/prestashop-security-module';
import logoCoronasIbericas from '../imx/logoci.webp';
import logoOmeya from '../imx/logoomeya.png';
import logoNana from '../imx/logonana.jpg';

const basePath = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
const moduleUrl = `${basePath}proyectos/prestashop-security-module/`;

const capabilityGroups = [
	{
		title: 'Desarrollo y tecnologías',
		items: ['PHP', 'Java', 'JavaScript', 'C#', 'HTML5', 'CSS3', 'Node.js', 'Spring Boot']
	},
	{
		title: 'Bases de datos y herramientas',
		items: ['MySQL', 'MariaDB', 'SQL', 'Git', 'Docker', 'XAMPP', 'PrestaShop']
	},
	{
		title: 'Marketing digital',
		items: ['SEO', 'SEM', 'Google Ads', 'GA4', 'Analítica web', 'Gestión de contenidos']
	},
	{
		title: 'Diseño y comunicación',
		items: ['Branding', 'Diseño publicitario', 'Canva', 'Photoshop', 'After Effects', 'Premiere', 'Probance']
	},
	{
		title: 'Certificaciones',
		items: [
			'Certificación de Google Analytics',
			'Google Ads Measurement Certification',
			'Hacking web y ethical hacking'
		]
	},
	{
		title: 'Idiomas',
		items: [
			'Inglés · B2',
			'Portugués · B1',
			'Castellano · Nativo',
			'Gallego · Nativo'
		]
	}
];

const featuredProjects = [
	{
		title: securityModule.title,
		type: 'Módulo privado · PrestaShop',
		highlight: 'Desarrollo propio de ciberseguridad para ecommerce',
		summary: securityModule.introduction,
		tools: securityModule.technologies,
		detailUrl: moduleUrl
	},
	{
		title: 'Audiovisual para landing Venditalia 2026',
		type: 'Evento B2B',
		status: 'Proyecto real',
		highlight: 'Proyectado ante miles de asistentes',
		summary:
			'Idea, diseño y montaje de todo el contenido audiovisual.',
		result:
			'El audiovisual se diseñó como una pieza central del stand para captar la atención en un entorno de gran afluencia y comunicar de forma inmediata la capacidad operativa de la empresa y el alcance de sus servicios. Se proyectó en bucle durante varias horas en pantallas de gran formato, consiguiendo visibilidad ante miles de asistentes.',
		tools: ['Premiere', 'After Effects', 'Edición de vídeo', 'Diseño audiovisual'],
		video: '/imx/Video_Italia_Final_web.mp4',
		image: '/imx/Venditalia-2026_800x800.jpg'
	},
	{
		title: 'Alma Matter',
		type: 'Web para gestión total de clases y alumnos',
		status: 'Proyecto personal',
		highlight: 'Aplicación académica full stack completamente funcional',
		summary:
			'Proyecto personal full stack para gestionar alumnos, asignaturas y exámenes en entidades que imparten cursos o clases online.',
		result:
			'Aplicación funcional y responsive con CRUD, búsqueda, paginación, validaciones y seguridad web. Complejidad media-alta.',
		tools: ['PHP', 'MySQL', 'JavaScript', 'CSS', 'Arquitectura MVC'],
		url: 'https://github.com/Ancodi1/Academia-Alma-Matter-Ancodi',
		image: '/imx/logo.png'
	},
	{
		title: 'Nana Nails',
		type: 'Web para negocio local',
		status: 'Trabajo finalizado',
		highlight: 'Presencia digital orientada a captar nuevos clientes',
		summary:
			'Diseño y desarrollo web para Nana Nails, creado para representar la identidad del negocio, presentar sus servicios de forma atractiva y mejorar su visibilidad en las búsquedas locales.',
		result:
			'Una web profesional, responsive y optimizada para facilitar que potenciales clientes encuentren el negocio, conozcan sus servicios y contacten con mayor facilidad.',
		tools: ['Astro', 'Diseño web', 'SEO local', 'Experiencia de usuario', 'Diseño responsive'],
		image: logoNana.src,
		url: 'https://www.nananailscarballo.com/',
	},
	{
		title: 'Guardia Omeya',
		type: 'Web para clan de gaming',
		status: 'Proyecto personal',
		summary:
			'Proyecto web para Guardia Omeya, un clan de Mount & Blade II: Bannerlord, pensado como espacio de presentación, comunidad e identidad del grupo.',
		tools: ['Diseño web', 'Desarrollo', 'Experiencia UX'],
		url: 'https://www.guardiaomeya.com/',
		image: logoOmeya.src
	},
	{
		title: 'Coronas Ibéricas',
		type: 'Colaboración en proyecto web',
		status: 'Trabajo finalizado',
		highlight: 'Colaborador del proyecto',
		summary:
			'Colaboración en el proyecto web de Coronas Ibéricas, web con conexiones en tiempo real a Discord y con acciones dinamicas.',
		tools: ['Colaboración web', 'Desarrollo web'],
		url: 'https://www.coronasibericas.com/',
		image: logoCoronasIbericas.src,
		containImage: true
	}
];

---

<Layout
	title="Desarrollador Full Stack Freelance en Galicia | Ángel Collazo"
	description="Desarrollador full stack freelance en Galicia. Desarrollo web, módulos PrestaShop a medida, PHP, MySQL y marketing digital para empresas de toda España."
>
	<div class="page-shell portfolio" id="top">
		<header class="topbar">
			<a class="brand" href="#top" aria-label="Ir al inicio"><img src={`${basePath}favicon.svg`} alt="Logo" /> Ángel Collazo Díaz</a>
			<nav aria-label="Secciones principales">
				<a href="#prestashop">PrestaShop</a>
				<a href="#proyectos">Proyectos</a>
				<a href="#disenos">Diseños</a>
				<a href="#contacto">Contacto</a>
			</nav>
		</header>

		<main>
			<section class="hero section">
				<p class="eyebrow">Desarrollador full stack freelance en Galicia</p>
				<h1>Desarrollo web y marketing digital para empresas que quieren posicionarse y vender mejor.</h1>
				<p class="hero-copy">
					Ayudo a marcas y empresas de Galicia y del resto de España con desarrollo full stack,
					diseño web, módulos PrestaShop a medida, SEO y campañas digitales para captar clientes.
				</p>
				<div class="hero-actions">
					<a class="button-primary" href="#proyectos">Ver proyectos</a>
					<a class="button-secondary" href="#contacto">Contactar conmigo</a>
					<a
						class="button-secondary"
						href={`${basePath}Angel-Collazo-Diaz-CV.pdf`}
						download="CV-Angel-Collazo-Diaz.pdf"
					>
						Descargar CV
					</a>
				</div>
			</section>

			<section class="section capabilities-band">
				<div class="capabilities-intro">
					<p class="section-kicker">Conocimientos y habilidades</p>
					<h2>Un profesional freelance para desarrollar, comunicar y hacer crecer proyectos digitales.</h2>
					<p>
						Combino programación, marketing digital y diseño para ofrecer un servicio completo,
						desde la parte técnica hasta el posicionamiento y la captación de clientes.
					</p>
				</div>

				<div class="capabilities-grid">
					{capabilityGroups.map((group) => (
						<article class="capability-card">
							<h3>{group.title}</h3>
							<ul class="capability-list">
								{group.items.map((item) => <li>{item}</li>)}
							</ul>
						</article>
					))}
				</div>
			</section>


			<section id="prestashop" class="section capabilities-band">
				<div class="capabilities-intro">
					<p class="section-kicker">Servicios de desarrollo</p>
					<h2>Desarrollo PrestaShop</h2>
					<p>Desarrollo de módulos personalizados para PrestaShop adaptados a las necesidades de cada negocio. Creación de nuevas funcionalidades, automatizaciones, integraciones y herramientas para Back Office y Front Office.</p>
				</div>
				<div class="capability-card">
					<h3>Módulos y soluciones a medida para tu tienda</h3>
					<p>¿Necesitas una funcionalidad que PrestaShop no incluye? Desarrollo módulos y soluciones a medida para tiendas PrestaShop. Acepto encargos freelance de integraciones, automatizaciones, adaptaciones de tiendas y desarrollo web para ecommerce.</p>
					<div><a class="button-primary" href="#contacto">Solicitar desarrollo</a></div>
				</div>
			</section>

		<section id="proyectos" class="section projects-band">
			<div class="projects-heading">
				<p class="section-kicker">Proyectos</p>
				<h2>Proyectos de desarrollo web, diseño y marketing digital.</h2>
			</div>

			<div class="projects-grid">
				{featuredProjects.map((project, index) => (
					<article class="project-card">
						{project.video ? (
							<>
								<button
									class="project-visual project-video-trigger"
									type="button"
									data-video-open={`project-video-${index}`}
									aria-label={`Reproducir vídeo de ${project.title}`}
								>
									<img src={project.image?.startsWith('/imx/') ? `${basePath}${project.image.slice(1)}` : project.image} alt="" loading="lazy" decoding="async" />
									<span class="project-play" aria-hidden="true">
										<svg viewBox="0 0 24 24">
											<path d="M8.5 6.2v11.6L18 12 8.5 6.2Z" />
										</svg>
									</span>
								</button>
								<dialog class="project-video-dialog" id={`project-video-${index}`}>
									<button class="project-video-close" type="button" aria-label="Cerrar vídeo">×</button>
									<video controls playsinline preload="metadata" poster={project.image?.startsWith('/imx/') ? `${basePath}${project.image.slice(1)}` : project.image}>
										<source src={`${basePath}${project.video.slice(1)}`} type="video/mp4" />
										Tu navegador no puede reproducir este vídeo.
									</video>
								</dialog>
							</>
						) : project.detailUrl ? (
							<a class="project-visual project-visual-link" href={project.detailUrl} aria-label={`Ver ficha de ${project.title}`}><span>{String(index + 1).padStart(2, '0')}</span></a>
						) : project.url ? (
							<a
								class="project-visual project-visual-link"
								href={project.url}
								target="_blank"
								rel="noreferrer"
								aria-label={`Ver proyecto ${project.title}`}
							>
								{project.image ? (
									<img
										src={project.image?.startsWith('/imx/') ? `${basePath}${project.image.slice(1)}` : project.image}
										alt={project.title}
										class:list={{ 'project-logo': project.containImage }}
										loading="lazy"
										decoding="async"
									/>
								) : (
									<span>{String(index + 1).padStart(2, '0')}</span>
								)}
							</a>
						) : (
							<div class="project-visual">
								{project.image ? (
									<img src={project.image?.startsWith('/imx/') ? `${basePath}${project.image.slice(1)}` : project.image} alt={project.title} loading="lazy" decoding="async" />
								) : (
									<span>{String(index + 1).padStart(2, '0')}</span>
								)}
							</div>
						)}
						<div class="project-content">
							<div class="project-meta">
								<p class="project-category">{project.type}</p>
								{project.status && <p class="project-status">{project.status}</p>}
							</div>
							<h4>
								{project.detailUrl ? (
									<a href={project.detailUrl}>{project.title}</a>
								) : project.url ? (
									<a href={project.url} target="_blank" rel="noreferrer">{project.title}</a>
								) : (
									project.title
								)}
							</h4>
							{project.highlight && <p class="project-highlight">{project.highlight}</p>}
							<p>{project.summary}</p>
							{project.result && <p class="project-result">{project.result}</p>}
							{project.tools && (
								<div class="project-tools" aria-label="Herramientas usadas">
									{project.tools.map((tool) => <span>{tool}</span>)}
								</div>
							)}
							{project.detailUrl && <a class="project-link" href={project.detailUrl}>Ver ficha del proyecto</a>}
							{project.video && (
								<button
									class="project-link project-video-link"
									type="button"
									data-video-open={`project-video-${index}`}
								>
									Reproducir vídeo
								</button>
							)}
							{project.url && (
								<a class="project-link" href={project.url} target="_blank" rel="noreferrer">
									{project.url.includes('github.com') ? 'Ver repositorio' : 'Ver proyecto'}
								</a>
							)}
						</div>
					</article>
				))}
			</div>
		</section>

		<DesignUploader />

			<section id="contacto" class="section contact-band">
				<div class="contact-copy">
					<p class="section-kicker">Contacto</p>
					<p>
						Disponible como desarrollador web y profesional de marketing digital freelance para
						proyectos en Galicia y toda España, incluidos módulos PrestaShop a medida,
						integraciones y automatizaciones para ecommerce. Puedes escribirme por email o visitar mi perfil
						de LinkedIn para conocer mi trayectoria.
					</p>
					<div class="contact-card">
						<p class="contact-name">Ángel Collazo Díaz</p>
						<p class="contact-role">Disponible para proyectos freelance</p>
						<p class="contact-email-context">
							Para propuestas de trabajo, colaboraciones o cualquier consulta, puedes escribirme
							directamente a:
						</p>
						<a class="contact-email" href="mailto:angelcollazodiaz@gmail.com">
							angelcollazodiaz@gmail.com
						</a>
						<a
							class="contact-cv"
							href={`${basePath}Angel-Collazo-Diaz-CV.pdf`}
							download="CV-Angel-Collazo-Diaz.pdf"
						>
							Descargar currículum
						</a>
						<a
							class="linkedin-card"
							href="https://www.linkedin.com/in/%C3%A1ngel-collazo-d%C3%ADaz-4896742a9/"
							target="_blank"
							rel="noreferrer"
							aria-label="Perfil de LinkedIn de Ángel Collazo Díaz"
						>
							<div class="linkedin-mark">
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path
										d="M6.94 8.5A1.56 1.56 0 1 1 6.94 5.38A1.56 1.56 0 0 1 6.94 8.5ZM5.58 18.42V9.7H8.3V18.42H5.58ZM10.02 18.42V9.7H12.63V10.89H12.67C13.03 10.2 13.92 9.47 15.24 9.47C17.98 9.47 18.5 11.27 18.5 13.61V18.42H15.79V14.16C15.79 13.14 15.77 11.83 14.38 11.83C12.98 11.83 12.77 12.92 12.77 14.08V18.42H10.02Z"
									/>
								</svg>
							</div>
							<div class="linkedin-copy">
								<p class="linkedin-label">LinkedIn</p>
								<p class="linkedin-name">Ángel Collazo Díaz</p>
							</div>
						</a>
					</div>
				</div>
			</section>
		</main>
	</div>
</Layout>

<script>
	const preparePageForPrint = () => {
		document.querySelectorAll('img[loading="lazy"]').forEach((image) => {
			image.setAttribute('loading', 'eager');
		});
	};

	window.addEventListener('beforeprint', preparePageForPrint);

	document.querySelectorAll('[data-video-open]').forEach((trigger) => {
		trigger.addEventListener('click', () => {
			const dialogId = trigger.getAttribute('data-video-open');
			const dialog = dialogId ? document.getElementById(dialogId) : null;

			if (dialog instanceof HTMLDialogElement) {
				dialog.showModal();
				dialog.querySelector('video')?.play().catch(() => {});
			}
		});
	});

	document.querySelectorAll('.project-video-dialog').forEach((dialog) => {
		if (!(dialog instanceof HTMLDialogElement)) return;

		const video = dialog.querySelector('video');
		const closeButton = dialog.querySelector('.project-video-close');
		const closeVideo = () => dialog.close();

		closeButton?.addEventListener('click', closeVideo);
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) closeVideo();
		});
		dialog.addEventListener('close', () => {
			if (video) {
				video.pause();
				video.currentTime = 0;
			}
		});
	});
</script>
